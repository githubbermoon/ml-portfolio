---
const trialEndsAt = "2026-10-15T18:29:59.000Z";
---

<div class="visitor-measurement" data-visitor-measurement data-trial-ends={trialEndsAt}>
  <aside class="visitor-consent" data-consent-prompt hidden aria-label="Visitor analytics choice">
    <p>Help me test how this site is visited.</p>
    <div class="visitor-consent__actions">
      <button type="button" data-consent-accept>Accept</button>
      <button type="button" data-consent-change>Change preferences</button>
    </div>
  </aside>

  <dialog class="visitor-preferences" data-consent-dialog>
    <form method="dialog" data-consent-form>
      <header>
        <p class="visitor-preferences__eyebrow">Visitor measurement</p>
        <button type="button" data-consent-close aria-label="Close preferences">×</button>
      </header>
      <p>
        During this one-month test, accepted analytics use first-party identifiers and a browser fingerprint.
        The server records the request IP, approximate location, visited page, referrer, device details and engagement.
      </p>
      <label>
        <input type="checkbox" data-consent-toggle />
        <span>Allow visitor analytics</span>
      </label>
      <button class="visitor-preferences__save" type="submit">Save changes</button>
    </form>
  </dialog>

  <button class="visitor-preferences-link" type="button" data-consent-reopen hidden>
    Change preferences
  </button>
</div>

<script>
  const CONSENT_COOKIE = "kosh_consent";
  const VISITOR_COOKIE = "kosh_visitor_id";
  const SESSION_COOKIE = "kosh_session_id";
  const COOKIE_MAX_AGE = 31 * 24 * 60 * 60;
  const SESSION_MAX_AGE = 30 * 60;

  function readCookie(name: string) {
    const prefix = `${encodeURIComponent(name)}=`;
    const part = document.cookie.split("; ").find((entry) => entry.startsWith(prefix));
    return part ? decodeURIComponent(part.slice(prefix.length)) : null;
  }

  function writeCookie(name: string, value: string, maxAge: number) {
    const secure = location.protocol === "https:" ? "; Secure" : "";
    document.cookie = `${encodeURIComponent(name)}=${encodeURIComponent(value)}; Path=/; Max-Age=${maxAge}; SameSite=Lax${secure}`;
  }

  function removeCookie(name: string) {
    document.cookie = `${encodeURIComponent(name)}=; Path=/; Max-Age=0; SameSite=Lax`;
  }

  function randomId() {
    return crypto.randomUUID?.() ?? `${Date.now().toString(36)}-${Math.random().toString(36).slice(2)}`;
  }

  function ensureIdentifiers() {
    let visitorId = readCookie(VISITOR_COOKIE);
    let sessionId = readCookie(SESSION_COOKIE);
    if (!visitorId) {
      visitorId = randomId();
      writeCookie(VISITOR_COOKIE, visitorId, COOKIE_MAX_AGE);
    }
    if (!sessionId) sessionId = randomId();
    writeCookie(SESSION_COOKIE, sessionId, SESSION_MAX_AGE);
    return { visitorId, sessionId };
  }

  function canvasSignature() {
    try {
      const canvas = document.createElement("canvas");
      canvas.width = 240;
      canvas.height = 60;
      const context = canvas.getContext("2d");
      if (!context) return "unavailable";
      context.textBaseline = "top";
      context.font = "16px serif";
      context.fillStyle = "#a1442f";
      context.fillRect(3, 3, 73, 19);
      context.fillStyle = "#203c49";
      context.fillText("Kosh · हिमवत · 012345", 7, 25);
      return canvas.toDataURL();
    } catch {
      return "blocked";
    }
  }

  function webglSignature() {
    try {
      const canvas = document.createElement("canvas");
      const gl = canvas.getContext("webgl");
      if (!gl) return "unavailable";
      const extension = gl.getExtension("WEBGL_debug_renderer_info");
      if (!extension) return "masked";
      return [
        gl.getParameter(extension.UNMASKED_VENDOR_WEBGL),
        gl.getParameter(extension.UNMASKED_RENDERER_WEBGL),
      ].join("|");
    } catch {
      return "blocked";
    }
  }

  async function hash(value: string) {
    if (crypto.subtle) {
      const bytes = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(value));
      return Array.from(new Uint8Array(bytes), (byte) => byte.toString(16).padStart(2, "0")).join("");
    }
    let result = 2166136261;
    for (let index = 0; index < value.length; index += 1) {
      result ^= value.charCodeAt(index);
      result = Math.imul(result, 16777619);
    }
    return `fallback-${(result >>> 0).toString(16)}`;
  }

  async function createFingerprint() {
    const nav = navigator as Navigator & { deviceMemory?: number };
    const components = [
      nav.userAgent,
      nav.platform,
      nav.language,
      nav.languages?.join(","),
      nav.hardwareConcurrency,
      nav.deviceMemory,
      nav.maxTouchPoints,
      screen.width,
      screen.height,
      screen.colorDepth,
      window.devicePixelRatio,
      Intl.DateTimeFormat().resolvedOptions().timeZone,
      canvasSignature(),
      webglSignature(),
    ];
    return hash(components.join("::"));
  }

  function sendEvent(payload: Record<string, unknown>, beacon = false) {
    const body = JSON.stringify(payload);
    if (beacon && navigator.sendBeacon) {
      navigator.sendBeacon("/api/analytics", new Blob([body], { type: "application/json" }));
      return;
    }
    fetch("/api/analytics", {
      method: "POST",
      headers: { "content-type": "application/json" },
      credentials: "same-origin",
      keepalive: true,
      body,
    }).catch(() => {});
  }

  async function beginMeasurement() {
    const { visitorId, sessionId } = ensureIdentifiers();
    const fingerprint = await createFingerprint();
    const startedAt = Date.now();
    let maximumScroll = 0;
    let sentEngagement = false;

    const updateScroll = () => {
      const scrollable = Math.max(1, document.documentElement.scrollHeight - innerHeight);
      maximumScroll = Math.max(maximumScroll, Math.min(100, Math.round((scrollY / scrollable) * 100)));
    };
    addEventListener("scroll", updateScroll, { passive: true });

    sendEvent({
      event: "page_view",
      visitorId,
      sessionId,
      fingerprint,
      path: `${location.pathname}${location.search}`.slice(0, 500),
      title: document.title.slice(0, 200),
      referrer: document.referrer.slice(0, 500),
      language: navigator.language,
      platform: navigator.platform,
      screen: `${screen.width}x${screen.height}@${window.devicePixelRatio}`,
    });

    const finish = () => {
      if (sentEngagement) return;
      sentEngagement = true;
      updateScroll();
      sendEvent({
        event: "engagement",
        visitorId,
        sessionId,
        fingerprint,
        path: `${location.pathname}${location.search}`.slice(0, 500),
        durationSeconds: Math.round((Date.now() - startedAt) / 1000),
        scrollDepth: maximumScroll,
      }, true);
    };
    addEventListener("pagehide", finish, { once: true });
    document.addEventListener("visibilitychange", () => {
      if (document.visibilityState === "hidden") finish();
    });

    document.addEventListener("click", (event) => {
      const target = event.target instanceof Element ? event.target.closest("a") : null;
      if (!(target instanceof HTMLAnchorElement)) return;
      const url = new URL(target.href, location.href);
      if (url.origin === location.origin) return;
      sendEvent({
        event: "outbound_click",
        visitorId,
        sessionId,
        fingerprint,
        path: location.pathname,
        destinationHost: url.hostname,
      }, true);
    });
  }

  const root = document.querySelector<HTMLElement>("[data-visitor-measurement]");
  const prompt = root?.querySelector<HTMLElement>("[data-consent-prompt]");
  const dialog = root?.querySelector<HTMLDialogElement>("[data-consent-dialog]");
  const toggle = root?.querySelector<HTMLInputElement>("[data-consent-toggle]");
  const reopen = root?.querySelector<HTMLButtonElement>("[data-consent-reopen]");
  const trialEnd = Date.parse(root?.dataset.trialEnds ?? "");
  const trialActive = Number.isFinite(trialEnd) && Date.now() < trialEnd;
  let measurementStarted = false;

  function showPreferences() {
    if (!dialog || !toggle) return;
    toggle.checked = readCookie(CONSENT_COOKIE) === "accepted";
    dialog.showModal();
  }

  function startOnce() {
    if (measurementStarted || !trialActive) return;
    measurementStarted = true;
    beginMeasurement();
  }

  if (root && prompt && reopen && trialActive) {
    const consent = readCookie(CONSENT_COOKIE);
    prompt.hidden = consent === "accepted" || consent === "declined";
    reopen.hidden = false;
    if (consent === "accepted") startOnce();

    root.querySelector("[data-consent-accept]")?.addEventListener("click", () => {
      writeCookie(CONSENT_COOKIE, "accepted", COOKIE_MAX_AGE);
      prompt.hidden = true;
      startOnce();
    });
    root.querySelector("[data-consent-change]")?.addEventListener("click", showPreferences);
    root.querySelector("[data-consent-reopen]")?.addEventListener("click", showPreferences);
    root.querySelector("[data-consent-close]")?.addEventListener("click", () => dialog?.close());
    root.querySelector("[data-consent-form]")?.addEventListener("submit", () => {
      if (toggle?.checked) {
        writeCookie(CONSENT_COOKIE, "accepted", COOKIE_MAX_AGE);
        prompt.hidden = true;
        startOnce();
      } else {
        writeCookie(CONSENT_COOKIE, "declined", COOKIE_MAX_AGE);
        removeCookie(VISITOR_COOKIE);
        removeCookie(SESSION_COOKIE);
        prompt.hidden = true;
      }
    });
  }
</script>

<style>
  .visitor-consent,
  .visitor-preferences-link {
    position: fixed;
    z-index: 10000;
    right: 0.9rem;
    bottom: 0.9rem;
    color: #efe9de;
    background: rgba(28, 25, 22, 0.94);
    border: 1px solid rgba(239, 233, 222, 0.3);
    box-shadow: 0 0.8rem 2.5rem rgba(0, 0, 0, 0.2);
    backdrop-filter: blur(12px);
    font: 0.72rem/1.35 "Neue Montreal", system-ui, sans-serif;
  }
  .visitor-consent {
    width: min(21rem, calc(100vw - 1.8rem));
    padding: 0.75rem;
  }
  .visitor-consent p { margin: 0 0 0.65rem; }
  .visitor-consent__actions { display: flex; gap: 0.45rem; }
  .visitor-consent button,
  .visitor-preferences button,
  .visitor-preferences-link {
    border: 1px solid currentColor;
    border-radius: 999px;
    padding: 0.42rem 0.72rem;
    color: inherit;
    background: transparent;
    cursor: pointer;
  }
  .visitor-consent button:first-child {
    color: #211d19;
    background: #efe9de;
  }
  .visitor-preferences-link {
    padding: 0.4rem 0.65rem;
    opacity: 0.68;
  }
  .visitor-preferences-link:hover { opacity: 1; }
  .visitor-preferences {
    width: min(28rem, calc(100vw - 2rem));
    padding: 0;
    color: #29231e;
    background: #eee8dd;
    border: 1px solid #51473e;
    font: 0.9rem/1.55 "Neue Montreal", system-ui, sans-serif;
  }
  .visitor-preferences::backdrop {
    background: rgba(12, 10, 8, 0.58);
    backdrop-filter: blur(5px);
  }
  .visitor-preferences form { padding: 1.2rem; }
  .visitor-preferences header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .visitor-preferences__eyebrow {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.7rem;
  }
  .visitor-preferences header button {
    border: 0;
    padding: 0.1rem 0.35rem;
    font-size: 1.35rem;
  }
  .visitor-preferences label {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 1.15rem 0;
    padding: 0.8rem 0;
    border-block: 1px solid rgba(41, 35, 30, 0.25);
  }
  .visitor-preferences__save { color: #eee8dd !important; background: #29231e !important; }
  [hidden] { display: none !important; }
  @media (max-width: 520px) {
    .visitor-consent__actions { align-items: stretch; flex-direction: column; }
  }
</style>
