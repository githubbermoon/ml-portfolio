---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";

const base = import.meta.env.BASE_URL;

const realms = [
  {
    label: "Technical Work",
    labelKey: "realm.technical.label",
    title: "Texts & Systems",
    titleKey: "realm.technical.title",
    href: base + "technical-work/",
    mark: "01",
    description:
      "Structured notes and research experiments around Vedic sciences, symbolic systems, and computation.",
    descriptionKey: "realm.technical.desc",
  },
  {
    label: "Kosh",
    labelKey: "realm.kosh.label",
    title: "कोश",
    titleKey: "realm.kosh.title",
    href: base + "blog/",
    mark: "⌁",
    description:
      "A living archive of notes, references, essays, and fragments gathered over time.",
    descriptionKey: "realm.kosh.desc",
  },
  {
    label: "Mist",
    labelKey: "realm.mist.label",
    title: "Ananta N",
    titleKey: "realm.mist.title",
    href: base + "blog/ananta-nihara/",
    mark: "∞",
    description:
      "An inner-world room for perception, mythic language, intelligence, and visual essays.",
    descriptionKey: "realm.mist.desc",
  },
  {
    label: "Projects",
    labelKey: "realm.projects.label",
    title: "Origins & Implementations",
    href: base + "projects/",
    mark: "△",
    description: "Functional builds and empirical tools.",
  },
];

---

<BaseLayout
  title="Kosh | Pranjal Prakash Pandey"
  description="Kosh by Pranjal Prakash Pandey: a living treasury of Vedic sciences, symbolic systems, personal notes, projects, and exploratory writing."
  tags={["Kosh", "Realms", "Vedic sciences", "symbolic systems", "ancient sciences", "Pranjal Prakash Pandey"]}
  bodyClass="realms-manuscript-home"
>
  <Nav />

  <main class="kosh-home">
    <section id="hero" class="manuscript-hero" data-section data-hero>
      <div class="paper-grain" aria-hidden="true"></div>
      <div class="hero-coordinate hero-coordinate-north" aria-hidden="true">उत्तर · 13°N</div>
      <div class="hero-coordinate hero-coordinate-east" aria-hidden="true">पूर्व · 77°E</div>

      <div class="manuscript-shell hero-layout">
        <div class="hero-copy">
          <div class="folio-line">
            <span data-i18n="home.hero.eyebrow">A living treasury</span>
            <span data-i18n="home.hero.folio">Folio 01</span>
          </div>

          <h1 aria-label="Kosh, कोश">
            <span class="hero-latin" data-i18n="home.hero.title">Kosh</span>
            <span class="hero-devanagari" data-no-translate>कोश</span>
          </h1>

          <p class="hero-definition" data-i18n="home.hero.subtitle">
            A living treasury of empirical sciences, symbolic systems, material
            experiments, and field notes.
          </p>

          <p class="hero-curator">
            <span data-i18n="home.hero.curated">Curated by</span>
            <strong data-i18n="home.hero.name">Pranjal Prakash Pandey</strong>
            <span class="hero-place" data-i18n="home.hero.place">Bengaluru · India</span>
          </p>

          <div class="hero-actions">
            <a class="primary-action" href={base + "blog/"}>
              <span data-i18n="home.hero.enter">Enter the Kosh</span>
              <span aria-hidden="true">↗</span>
            </a>
            <a class="text-action" href="#capabilities">
              <span data-i18n="home.hero.explore">Explore the realms</span>
              <span aria-hidden="true">↓</span>
            </a>
          </div>
        </div>

      </div>

      <div class="hero-foot manuscript-shell" aria-hidden="true">
        <span data-no-translate>ज्ञानेन प्रकाशते कोशः</span>
        <span data-i18n="home.hero.scroll">Scroll to unfold</span>
      </div>
    </section>

    <section id="capabilities" class="manuscript-section realms-section" data-section>
      <div class="manuscript-shell">
        <div class="realms-summary-row editorial-reveal">
          <p class="section-summary" data-i18n="home.realms.subtitle">
            Enter through any field. Each is a different way of observing,
            preserving, and making sense of the world.
          </p>
        </div>

        <div class="realm-ledger">
          {
            realms.map((realm, index) => (
              <a class="realm-entry editorial-reveal" href={realm.href} data-cursor="OPEN">
                <span class="realm-index">0{index + 1}</span>
                <span class="realm-label" data-i18n={realm.labelKey}>{realm.label}</span>
                <span class="realm-mark" aria-hidden="true">{realm.mark}</span>
                <h3 data-i18n={realm.titleKey}>{realm.title}</h3>
                <p data-i18n={realm.descriptionKey}>{realm.description}</p>
                <span class="realm-open" aria-hidden="true" data-i18n="home.realms.open">Open realm ↗</span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="manuscript-section statement-section" data-section>
      <div class="manuscript-shell statement-layout">
        <div class="section-number">03</div>
        <p class="section-kicker" data-i18n="home.statement.eyebrow">A guiding thought</p>
        <blockquote data-i18n="home.statement.text">
          This is a place for slow attention: to study inherited systems, test them
          against lived experience, and build new tools without stripping away their context.
        </blockquote>
      </div>
    </section>

    <section id="contact" class="contact-section" data-section>
      <div class="manuscript-shell contact-layout">
        <div>
          <p class="section-kicker" data-i18n="contact.eyebrow">Correspondence</p>
          <h2 data-i18n="contact.title">Begin a conversation</h2>
        </div>
        <div class="contact-copy">
          <p data-i18n="contact.subtitle">
            For thoughtful conversations, collaborations, suggestions, or shared curiosities.
          </p>
          <a class="contact-email" href="mailto:prakashpranjal001@gmail.com">
            <span data-i18n="contact.write">Write to me</span>
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <footer class="manuscript-footer">
    <div class="manuscript-shell">
      <span data-i18n="home.footer.copyright">© 2026 Himavat — Pranjal Prakash Pandey. All rights reserved.</span>
      <span data-i18n="home.footer.place">Kosh · Bengaluru</span>
      <a class="home-rights-link" href={base + "rights/"}>Usage &amp; Rights</a>
    </div>
  </footer>
</BaseLayout>

<style>
  .kosh-home,
  .manuscript-footer {
    --paper: #17120e;
    --paper-raised: #211a14;
    --paper-deep: #100c09;
    --manuscript-ink: #f1e2c9;
    --manuscript-muted: #bca98d;
    --rule: rgb(217 187 145 / 0.2);
    --rule-strong: rgb(217 187 145 / 0.38);
    --vermillion: #c55b3f;
    --copper: #b78852;
    color: var(--manuscript-ink);
    background: var(--paper);
  }

  :global(html[data-theme="bright"]) .kosh-home,
  :global(html[data-theme="bright"]) .manuscript-footer {
    --paper: #fdfcfb;
    --paper-raised: #ffffff;
    --paper-deep: #f4f0e9;
    --manuscript-ink: #241a13;
    --manuscript-muted: #715f4f;
    --rule: rgb(75 52 35 / 0.18);
    --rule-strong: rgb(75 52 35 / 0.36);
    --vermillion: #9f3d29;
    --copper: #946336;
  }

  :global(body.realms-manuscript-home) {
    background: #17120e;
  }

  :global(html[data-theme="bright"] body.realms-manuscript-home) {
    background: #fdfcfb;
  }

  .manuscript-shell {
    position: relative;
    z-index: 2;
    width: min(100% - 3rem, 1240px);
    margin-inline: auto;
  }

  .home-rights-link {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.25rem;
    transition: color 160ms ease, text-decoration-color 160ms ease;
  }

  .home-rights-link:hover {
    color: var(--vermillion);
    text-decoration-color: currentColor;
  }

  .manuscript-hero {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    border-bottom: 1px solid var(--rule-strong);
    background:
      radial-gradient(circle at 78% 42%, color-mix(in srgb, var(--vermillion) 8%, transparent), transparent 28%),
      linear-gradient(90deg, transparent 49.93%, var(--rule) 50%, transparent 50.07%),
      var(--paper);
  }

  .paper-grain {
    position: absolute;
    inset: 0;
    opacity: 0.18;
    pointer-events: none;
    background-image:
      repeating-linear-gradient(7deg, transparent 0 4px, rgb(255 255 255 / 0.02) 5px),
      radial-gradient(circle at 20% 30%, rgb(135 83 47 / 0.18) 0 0.7px, transparent 0.9px);
    background-size: auto, 7px 7px;
    mix-blend-mode: soft-light;
  }

  .hero-coordinate {
    position: absolute;
    z-index: 2;
    color: var(--manuscript-muted);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    writing-mode: vertical-rl;
    opacity: 0.62;
  }

  .hero-coordinate-north { left: 1rem; top: 42%; }
  .hero-coordinate-east { right: 1rem; top: 22%; }

  .hero-layout {
    display: flex;
    align-items: center;
    min-height: calc(100svh - 5rem);
    padding-top: clamp(8.5rem, 17vh, 11rem);
    padding-bottom: 6.5rem;
  }

  .hero-copy { width: min(100%, 760px); }

  .folio-line {
    display: flex;
    align-items: center;
    gap: 1rem;
    width: min(100%, 620px);
    color: var(--vermillion);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .folio-line::after {
    content: "";
    order: 2;
    flex: 1;
    height: 1px;
    background: var(--rule-strong);
  }

  .folio-line span:last-child { order: 3; color: var(--manuscript-muted); }

  .hero-copy h1 {
    display: flex;
    align-items: baseline;
    gap: 0.14em;
    margin-top: 1.4rem;
    color: var(--manuscript-ink);
    font-size: clamp(7.2rem, 14.5vw, 13.2rem);
    line-height: 0.72;
  }

  .hero-latin {
    font-family: "Cormorant Garamond", var(--font-display);
    font-weight: 500;
    letter-spacing: -0.078em;
    font-feature-settings: "liga" 1, "kern" 1;
  }

  .hero-devanagari {
    color: var(--vermillion);
    font-family: "Noto Serif Devanagari", Georgia, serif;
    font-size: 0.32em;
    font-weight: 500;
    letter-spacing: -0.025em;
  }

  :global(html[data-lang="hi"]) .hero-latin {
    display: none;
  }

  .hero-definition {
    max-width: 680px;
    margin-top: 2.4rem;
    color: var(--manuscript-muted);
    font-family: "Cormorant Garamond", var(--font-display);
    font-size: clamp(1.5rem, 2.7vw, 2.25rem);
    font-style: italic;
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: -0.012em;
  }

  .hero-curator {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.2rem 0.8rem;
    width: fit-content;
    margin-top: 2.2rem;
    padding-left: 1rem;
    border-left: 2px solid var(--vermillion);
    color: var(--manuscript-muted);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .hero-curator strong { color: var(--manuscript-ink); font-weight: 500; }
  .hero-place { grid-column: 2; opacity: 0.72; }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    align-items: center;
    margin-top: 2.8rem;
  }

  .primary-action,
  .text-action {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    min-height: 3.25rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition: 220ms ease;
  }

  .primary-action {
    min-width: 13.5rem;
    border: 1px solid var(--manuscript-ink);
    padding: 0 1.1rem;
    color: var(--paper);
    background: var(--manuscript-ink);
  }

  .primary-action:hover {
    border-color: var(--vermillion);
    background: var(--vermillion);
    transform: translateY(-2px);
  }

  .text-action { color: var(--manuscript-muted); }
  .text-action:hover { color: var(--vermillion); }

  .hero-foot {
    display: flex;
    justify-content: space-between;
    margin-top: -4.3rem;
    padding-bottom: 2rem;
    color: var(--manuscript-muted);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .manuscript-section {
    position: relative;
    padding: clamp(6rem, 11vw, 10rem) 0;
    border-bottom: 1px solid var(--rule-strong);
    background: var(--paper-raised);
  }

  .realms-section::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: linear-gradient(90deg, transparent calc(50% - 0.5px), var(--rule) 50%, transparent calc(50% + 0.5px));
    opacity: 0.6;
  }

  .section-intro {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr) minmax(280px, 0.62fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: end;
    margin-bottom: 4rem;
  }

  .section-number {
    color: var(--vermillion);
    font-family: var(--font-display);
    font-size: 3.2rem;
    font-style: italic;
    line-height: 1;
    opacity: 0.8;
  }

  .section-kicker,
  .realm-label,
  .realm-index,
  .recent-number {
    color: var(--manuscript-muted);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .section-intro h2,
  .contact-layout h2 {
    margin-top: 0.8rem;
    color: var(--manuscript-ink);
    font-size: clamp(3rem, 6vw, 5.8rem);
    font-weight: 420;
    line-height: 0.92;
    letter-spacing: -0.045em;
  }

  .section-summary {
    max-width: 450px;
    color: var(--manuscript-muted);
    font-family: var(--font-display);
    font-size: 1.16rem;
    line-height: 1.65;
  }

  .realms-summary-row {
    display: flex;
    justify-content: flex-end;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  .realm-ledger {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--rule-strong);
    border-bottom: 1px solid var(--rule-strong);
  }

  .realm-entry {
    position: relative;
    min-width: 0;
    border-right: 1px solid var(--rule-strong);
    padding: 1.5rem clamp(1rem, 2vw, 1.6rem) 1.8rem;
    color: var(--manuscript-ink);
    transition: color 180ms ease;
  }

  .realm-entry:last-child { border-right: 0; }

  .realm-entry::after {
    content: "";
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    width: 1.6rem;
    height: 1px;
    background: var(--vermillion);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 180ms ease;
  }

  .realm-entry:hover::after { transform: scaleX(1); }
  .realm-index { position: relative; z-index: 1; color: var(--vermillion); }
  .realm-label { display: block; margin-top: 1rem; }

  .realm-mark { display: none; }

  .realm-entry h3 {
    position: relative;
    z-index: 1;
    max-width: 12ch;
    margin-top: 1.6rem;
    color: inherit;
    font-size: clamp(1.35rem, 2vw, 1.8rem);
    font-weight: 420;
    line-height: 1.04;
  }

  .realm-entry p {
    position: relative;
    z-index: 1;
    margin-top: 1rem;
    color: var(--manuscript-muted);
    font-size: 0.82rem;
    line-height: 1.6;
  }

  .realm-open {
    position: absolute;
    display: none;
  }

  .statement-section {
    background:
      radial-gradient(circle at 75% 52%, color-mix(in srgb, var(--vermillion) 10%, transparent), transparent 22%),
      var(--paper-deep);
  }

  .statement-layout {
    display: grid;
    grid-template-columns: 4.5rem minmax(120px, 0.25fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: start;
  }

  .statement-layout blockquote {
    max-width: 850px;
    color: var(--manuscript-ink);
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.5vw, 2.35rem);
    line-height: 1.3;
    letter-spacing: -0.035em;
  }

  .contact-section {
    padding: clamp(6rem, 10vw, 9rem) 0;
    background: var(--vermillion);
  }

  .contact-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 0.7fr);
    gap: clamp(3rem, 8vw, 8rem);
    align-items: end;
  }

  .contact-section .section-kicker,
  .contact-layout h2,
  .contact-copy,
  .contact-copy a { color: #f7ead6; }

  .contact-copy > p {
    max-width: 500px;
    color: rgb(247 234 214 / 0.78);
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 1.55;
  }

  .contact-email {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    margin-top: 2rem;
    border-top: 1px solid rgb(247 234 214 / 0.4);
    border-bottom: 1px solid rgb(247 234 214 / 0.4);
    padding: 1rem 0;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .manuscript-footer { border-top: 1px solid var(--rule-strong); }

  .manuscript-footer .manuscript-shell {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 2rem;
    color: var(--manuscript-muted);
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  @media (max-width: 980px) {
    .hero-layout { padding-top: 9rem; }
    .section-intro { grid-template-columns: 4rem 1fr; }
    .section-summary { grid-column: 2; }

    .statement-layout { grid-template-columns: 4rem minmax(0, 1fr); }
    .statement-layout .section-kicker { grid-column: 2 / -1; }
    .statement-layout blockquote { grid-column: 2; }
  }

  @media (max-width: 720px) {
    .manuscript-shell { width: min(100% - 2rem, 1240px); }
    .manuscript-hero { min-height: auto; }

    .hero-layout {
      min-height: 92svh;
      padding-top: 8rem;
      padding-bottom: 5rem;
    }

    .hero-copy h1 { display: block; font-size: clamp(5.7rem, 27vw, 8.5rem); }

    .hero-devanagari {
      display: block;
      margin-top: 0.25em;
      font-size: 0.42em;
      letter-spacing: 0;
    }

    .hero-definition { max-width: 88%; font-size: 1.3rem; }
    .hero-curator { grid-template-columns: 1fr; }
    .hero-place { grid-column: 1; }
    .hero-foot { margin-top: -3.5rem; }
    .hero-foot span:last-child { display: none; }

    .section-intro,
    .contact-layout,
    .statement-layout { grid-template-columns: 1fr; }

    .section-number { font-size: 2.3rem; }

    .section-summary,
    .statement-layout .section-kicker,
    .statement-layout blockquote,
    .realm-ledger {
      grid-template-columns: repeat(4, minmax(230px, 1fr));
      overflow-x: auto;
      scroll-snap-type: x proximity;
    }

    .realm-entry { scroll-snap-align: start; }

    .manuscript-footer .manuscript-shell { flex-direction: column; }
  }

  @media (max-width: 480px) {
    .folio-line span:last-child { display: none; }
    .hero-actions { align-items: stretch; flex-direction: column; }
    .primary-action, .text-action { width: 100%; }
  }
</style>
