---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";

const base = import.meta.env.BASE_URL;
const heroImage = base + "images/atmosphere/storm-light.webp";

const realms = [
  {
    label: "Technical Work",
    labelKey: "realm.technical.label",
    title: "Texts & Systems",
    titleKey: "realm.technical.title",
    href: base + "technical-work/",
    mark: "01",
    description:
      "Structured notes and research experiments around symbolic systems and computation.",
    descriptionKey: "realm.technical.desc",
  },
  {
    label: "Kosh",
    labelKey: "realm.kosh.label",
    title: "कोश",
    titleKey: "realm.kosh.title",
    href: base + "blog/",
    mark: "⌁",
    description:
      "A living archive of notes, references, essays, and fragments gathered over time.",
    descriptionKey: "realm.kosh.desc",
  },
  {
    label: "Mist",
    labelKey: "realm.mist.label",
    title: "Ananta N",
    titleKey: "realm.mist.title",
    href: base + "blog/ananta-n/",
    mark: "∞",
    description:
      "An inner-world room for perception, mythic language, intelligence, and visual essays.",
    descriptionKey: "realm.mist.desc",
  },
  {
    label: "Projects",
    labelKey: "realm.projects.label",
    title: "Origins & Implementations",
    href: base + "projects/",
    mark: "△",
    description: "Functional builds and empirical tools.",
  },
];

---

<BaseLayout
  title="Kosh | Pranjal Prakash Pandey"
  description="Kosh by Pranjal Prakash Pandey: a living treasury of Vedic sciences, symbolic systems, personal notes, projects, and exploratory writing."
  tags={["Kosh", "Realms", "Vedic sciences", "symbolic systems", "ancient sciences", "Pranjal Prakash Pandey"]}
  bodyClass="realms-manuscript-home"
>
  <Nav />

  <main class="kosh-home">
    <section id="hero" class="manuscript-hero" data-section data-hero>
      <div class="paper-grain" aria-hidden="true"></div>

      <div class="home-hero-stage manuscript-shell">
        <h1 class="home-cross-title" aria-label="A living treasury">
          <span>A</span> <em>living</em> <span>treasury.</span>
        </h1>

        <span class="hero-devanagari" data-no-translate>कोश</span>

        <figure class="home-hero-plate">
          <div class="home-hero-print">
            <img src={heroImage} alt="Rain falling through sunlight over a mountain landscape" loading="eager" fetchpriority="high" />
          </div>
          <p class="home-cross-title home-cross-title--reverse" aria-hidden="true">
            <span>A</span> <em>living</em> <span>treasury.</span>
          </p>
          <figcaption><span>Plate 01</span> Light, weather, and the field of attention</figcaption>
        </figure>

        <p class="home-stage-note home-stage-note--left">Empirical sciences,<br />symbolic systems,<br />material experiments.</p>
        <p class="home-stage-note home-stage-note--right">Notes and essays<br />for the <em>world.</em></p>
      </div>

    </section>

    <section id="capabilities" class="manuscript-section realms-section" data-section>
      <div class="section-double-rule" aria-hidden="true"><div class="rule-glyph-pattern">{Array.from({length: 3}, () => <><span class="rule-pair"><i>5</i><i class="rule-mirror">5</i></span><i>.</i><span class="rule-pair"><i>5</i><i class="rule-mirror">5</i></span><span class="rule-pair"><i>.</i><i class="rule-mirror">.</i></span><i class="rule-glyph--up">0</i><span class="rule-pair"><i>5</i><i class="rule-mirror">5</i></span><i>.</i><i class="rule-glyph--down">4</i></>)}</div></div>
      <div class="manuscript-shell">
        <div class="realms-summary-row editorial-reveal">
          <div class="realms-heading"><h2 class="home-directory-label"><span class="directory-ornament directory-ornament--left" aria-hidden="true">U</span><span>Directory of Fields</span><span class="directory-ornament" aria-hidden="true">U</span></h2><p class="section-kicker">01</p></div>
        </div>

        <div class="realm-ledger">
          {
            realms.map((realm, index) => (
              <a class="realm-entry editorial-reveal" href={realm.href} data-cursor="OPEN">
                <span class="realm-index">0{index + 1}</span>
                <span class="realm-mark" aria-hidden="true">{realm.mark}</span>
                <h3 data-i18n={realm.titleKey}>{realm.title}</h3>
                <p data-i18n={realm.descriptionKey}>{realm.description}</p>
                <span class="realm-open" aria-hidden="true">↗</span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="home-author" id="about" data-section>
      <div class="section-double-rule" aria-hidden="true"><div class="rule-glyph-pattern rule-glyph-pattern--balanced">
        {[false, true].map((mirrored) => <div class:list={["rule-half", mirrored && "rule-half--right"]}>{Array.from({length: 2}, () => <><span class="rule-pair"><i>5</i><i class="rule-mirror">5</i></span><span class="rule-pair"><i>.</i><i class="rule-mirror">.</i></span></>)}<i class="rule-glyph--down">4</i><span class="rule-pair"><i>5</i><i class="rule-mirror">5</i></span><span class="rule-pair"><i>.</i><i class="rule-mirror">.</i></span></div>)}
        <i class="rule-glyph--up rule-center">0</i>
      </div></div>
      <div class="manuscript-shell home-author-grid">
        <h2 class="home-about-label"><span class="about-ornament" aria-hidden="true">t</span><span>ABOUT ME</span><span class="about-ornament" aria-hidden="true">t</span></h2>
        <div><p class="section-kicker">02</p><h3>Pranjal<br />Prakash<br />Pandey</h3><a class="home-personal-link" href={base + "about/pranjal/"}><i class="portrait-ornament" aria-hidden="true"><b>o</b></i><img src={base + "about/pranjal/portrait.jpg"} alt="Pranjal standing in snow, with footprints leading toward him" loading="lazy" /><i class="portrait-ornament" aria-hidden="true"><b>o</b></i><span>Photos &amp; words ↗</span></a></div>
        <div class="home-author-copy"><p>I work across machine-learning systems, computer vision, spatial research, and an expanding study of calendrical and symbolic systems. Kosh is the public notebook where those worlds can remain adjacent without being collapsed into one another.</p><p>The recurring interests are observation, traceability, human interpretation, and the kinds of knowledge that lose something when they are made too neat.</p>
        </div>
      </div>
    </section>

    <section id="contact" class="contact-section" data-section>
      <span class="contact-watermark" aria-hidden="true">Correspondence</span>
      <div class="manuscript-shell contact-layout">
        <div>
          <p class="section-kicker" data-i18n="contact.eyebrow">Correspondence</p>
          <h2 data-i18n="contact.title">Begin a conversation</h2>
        </div>
        <div class="contact-copy">
          <p class="contact-card-meta">An open invitation / Bengaluru, India</p>
          <p data-i18n="contact.subtitle">
            For thoughtful conversations, collaborations, suggestions, or shared curiosities.
          </p>
          <a class="contact-email" href="mailto:pranjalp1@icloud.com">
            <span data-i18n="contact.write">Write to me</span>
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <footer class="manuscript-footer">
    <div class="manuscript-shell">
      <span class="footer-copyright">© 2026 Pranjal Prakash Pandey</span>
      <span class="footer-location">Bengaluru · India</span>
      <nav class="footer-links" aria-label="Footer navigation">
        <a class="home-rights-link" href={base + "rights/"}>Usage &amp; rights</a>
        <a class="home-rights-link" href="#hero">Back to top <span aria-hidden="true">↑</span></a>
      </nav>
    </div>
  </footer>
</BaseLayout>

<script>
  import gsap from "gsap";
  import SplitText from "gsap/SplitText";

  gsap.registerPlugin(SplitText);
  const motionPreference = matchMedia("(prefers-reduced-motion: reduce)");
  document.fonts.ready.then(() => {
    if (motionPreference.matches || !document.querySelector(".kosh-home")) return;
    const animations: gsap.core.Tween[] = [];
    const splits: SplitText[] = [];
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        observer.unobserve(entry.target);
        const target = entry.target as HTMLElement;
        if (target.matches(".realms-heading h2, .home-author h2, .home-author h3, .contact-layout h2")) {
          const split = SplitText.create(target, { type: "lines", autoSplit: true, aria: "auto", onSplit: (instance) => {
            const tween = gsap.from(instance.lines, { opacity: 0, y: 14, duration: .75, stagger: .08, ease: "power2.out", clearProps: "opacity,transform" });
            animations.push(tween);
            return tween;
          } });
          splits.push(split);
        } else {
          animations.push(gsap.from(target, { opacity: 0, y: 10, duration: .7, delay: target.matches(".realm-entry") ? Number(target.dataset.motionOrder ?? 0) * .06 : 0, ease: "power2.out", clearProps: "opacity,transform" }));
        }
      });
    }, { threshold: .12 });
    document.querySelectorAll<HTMLElement>(".realm-entry").forEach((row, index) => { row.dataset.motionOrder = String(index); });
    document.querySelectorAll(".realms-heading h2, .section-summary, .realm-entry, .home-author h2, .home-author h3, .home-author-copy > p, .contact-layout h2, .contact-copy > p").forEach((element) => observer.observe(element));
    motionPreference.addEventListener("change", (event) => {
      if (!event.matches) return;
      observer.disconnect();
      animations.forEach((animation) => animation.progress(1));
      splits.forEach((split) => split.revert());
    });
  });
</script>

<style>
  .kosh-home,
  .manuscript-footer {
    --paper: #17120e;
    --paper-raised: #211a14;
    --paper-deep: #100c09;
    --manuscript-ink: #f1e2c9;
    --manuscript-muted: #bca98d;
    --rule: rgb(217 187 145 / 0.2);
    --rule-strong: rgb(217 187 145 / 0.38);
    --vermillion: #c55b3f;
    --copper: #b78852;
    --home-display: "DaVinci Trial", Georgia, serif;
    --home-reading: "Louize Trial", Georgia, serif;
    --home-interface: "Neue Montreal Trial", Arial, sans-serif;
    color: var(--manuscript-ink);
    background: var(--paper);
    overflow-x: hidden;
    overflow-x: clip;
  }

  :global(html[data-theme="bright"]) .kosh-home,
  :global(html[data-theme="bright"]) .manuscript-footer {
    --paper: #f4f3f1;
    --paper-raised: #f4f3f1;
    --paper-deep: #e9e7e3;
    --manuscript-ink: #241a13;
    --manuscript-muted: #715f4f;
    --rule: rgb(75 52 35 / 0.18);
    --rule-strong: rgb(75 52 35 / 0.36);
    --vermillion: #9f3d29;
    --copper: #946336;
  }

  :global(body.realms-manuscript-home) {
    background: #17120e;
  }

  :global(html[data-theme="bright"] body.realms-manuscript-home) {
    background: #fdfcfb;
  }

  .manuscript-shell {
    position: relative;
    z-index: 2;
    width: min(100% - 3rem, 1240px);
    margin-inline: auto;
  }

  .home-rights-link {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.25rem;
    transition: color 160ms ease, text-decoration-color 160ms ease;
  }

  .home-rights-link:hover {
    color: var(--vermillion);
    text-decoration-color: currentColor;
  }

  .manuscript-hero {
    position: relative;
    min-height: 108svh;
    overflow: hidden;
    border-bottom: 1px solid var(--rule-strong);
    background: var(--paper);
  }

  .paper-grain {
    position: absolute;
    inset: 0;
    opacity: 0.18;
    pointer-events: none;
    background-image:
      repeating-linear-gradient(7deg, transparent 0 4px, rgb(255 255 255 / 0.02) 5px),
      radial-gradient(circle at 20% 30%, rgb(135 83 47 / 0.18) 0 0.7px, transparent 0.9px);
    background-size: auto, 7px 7px;
    mix-blend-mode: soft-light;
  }

  .home-hero-meta {
    position: relative;
    z-index: 3;
    display: flex;
    justify-content: space-between;
    margin: 0 1rem;
    border-top: 1px solid var(--rule-strong);
    padding-top: .6rem;
    color: var(--manuscript-muted);
    font: 500 .56rem/1 var(--home-interface);
    letter-spacing: .12em;
    text-transform: uppercase;
    transform: translateY(6.5rem);
  }

  .home-hero-stage {
    --title-y: 46%;
    z-index: 4;
    height: min(80svh, 52rem);
    min-height: 43rem;
    margin-top: 8rem;
  }

  .home-cross-title {
    position: absolute;
    z-index: 1;
    top: var(--title-y);
    left: 50%;
    width: 100vw;
    margin: 0;
    color: var(--manuscript-ink);
    font: 400 clamp(5rem, 12.3vw, 13.5rem)/.92 var(--home-reading);
    letter-spacing: -.065em;
    text-align: center;
    white-space: nowrap;
    transform: translate(-50%, -50%);
  }

  .home-cross-title em { font-style: italic; }

  .home-hero-plate {
    position: absolute;
    z-index: 2;
    top: 0;
    bottom: 0;
    left: 50%;
    width: min(43vw, 45rem);
    margin: 0;
    overflow: hidden;
    padding: clamp(3.2rem, 5vw, 5.2rem) clamp(1.4rem, 2.5vw, 2.6rem) clamp(3rem, 4.5vw, 4.5rem);
    color: #25221d;
    background: #f2efe6;
    box-shadow: 0 .4rem 1.1rem rgb(49 38 27 / .1), 0 2rem 5rem rgb(49 38 27 / .08);
    transform: translateX(-50%) rotate(-.35deg);
  }

  .home-hero-plate::before,
  .home-hero-plate::after {
    content: "";
    position: absolute;
    z-index: 5;
    top: .8rem;
    width: 4.4rem;
    height: 1.25rem;
    background: rgb(205 186 139 / .48);
    box-shadow: inset 0 0 .2rem rgb(116 92 49 / .15);
    mix-blend-mode: multiply;
  }

  .home-hero-plate::before { left: .8rem; transform: rotate(-7deg); }
  .home-hero-plate::after { right: .8rem; transform: rotate(6deg); }

  .home-hero-print {
    position: absolute;
    inset: clamp(3.2rem, 5vw, 5.2rem) clamp(1.4rem, 2.5vw, 2.6rem) clamp(3rem, 4.5vw, 4.5rem);
    overflow: hidden;
    background: #34291f;
  }

  .home-hero-print::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    box-shadow: inset 0 0 0 1px rgb(37 34 29 / .16);
  }

  .home-hero-print img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: none;
  }

  .home-cross-title--reverse {
    z-index: 4;
    top: var(--title-y);
    color: #fffdf6;
    pointer-events: none;
  }

  .home-hero-plate figcaption {
    position: absolute;
    right: 1.1rem;
    bottom: 1rem;
    left: 1.1rem;
    z-index: 5;
    display: flex;
    justify-content: space-between;
    font: 500 .48rem/1.2 var(--home-interface);
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .home-stage-note {
    position: absolute;
    z-index: 3;
    bottom: 14%;
    margin: 0;
    color: var(--manuscript-ink);
    font: 500 clamp(1rem, 1.5vw, 1.35rem)/1.35 var(--home-reading);
  }

  .home-stage-note--left { left: 2%; text-align: right; }
  .home-stage-note--right { right: 1%; }
  .home-stage-note em { font-style: italic; }

  .home-hero-stage > .hero-devanagari {
    position: absolute;
    z-index: 5;
    top: -3.7rem;
    left: 50%;
    color: var(--vermillion);
    font: 500 clamp(1.7rem, 2.8vw, 3rem)/1 "Noto Serif Devanagari", Georgia, serif;
    transform: translateX(-50%);
  }

  .home-hero-coda {
    z-index: 5;
    display: grid;
    grid-template-columns: minmax(18rem, .85fr) minmax(20rem, .65fr);
    justify-content: space-between;
    gap: clamp(3rem, 10vw, 10rem);
    align-items: end;
    padding-block: 5rem 6rem;
    border-top: 1px solid var(--rule-strong);
  }

  .home-hero-invitation {
    max-width: 27rem;
    justify-self: end;
    color: var(--manuscript-muted);
    font: 400 clamp(1.2rem, 1.7vw, 1.55rem)/1.4 var(--home-reading);
  }

  .hero-definition {
    max-width: 30rem;
    margin: 0;
    color: var(--manuscript-ink);
    font: 400 clamp(1.35rem, 2.2vw, 2rem)/1.35 var(--home-reading);
    letter-spacing: -.015em;
  }

  .home-hero-coda { grid-template-columns: 1.2fr .8fr; gap: clamp(2rem,5vw,5rem); align-items: center; padding-block: 3rem 5rem; }
  .home-coda-kicker { margin: 0 0 1.5rem; color: var(--vermillion); font: 500 .62rem/1.5 var(--home-interface); letter-spacing: .14em; text-transform: uppercase; }
  .home-invitation-card { padding: 2rem; border: 1px solid var(--rule-strong); background: var(--paper-raised); transform: rotate(1deg); box-shadow: .6rem .6rem 0 var(--paper-deep); }
  .home-invitation-card > span { display: block; margin-bottom: 2rem; color: var(--vermillion); font-size: 1.6rem; }
  .home-invitation-card .home-hero-invitation { margin: 0; color: var(--manuscript-ink); }
  .home-invitation-meta { border-top: 1px solid var(--rule-strong); padding-top: 1rem; margin: 1.5rem 0 0; color: var(--manuscript-muted); font: 500 .6rem/1.5 var(--home-interface); letter-spacing: .14em; text-transform: uppercase; }


  .hero-curator {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.2rem 0.8rem;
    width: fit-content;
    margin-top: 2.2rem;
    padding-left: 1rem;
    border-left: 2px solid var(--vermillion);
    color: var(--manuscript-muted);
    font-family: var(--home-interface);
    font-size: 0.64rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .hero-curator strong { color: var(--manuscript-ink); font-weight: 500; }
  .hero-place { grid-column: 2; opacity: 0.72; }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    align-items: center;
    margin-top: 2.8rem;
  }

  .primary-action,
  .text-action {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    min-height: 3.25rem;
    font-family: var(--home-interface);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition: 220ms ease;
  }

  .primary-action {
    min-width: 13.5rem;
    border: 1px solid var(--manuscript-ink);
    padding: 0 1.1rem;
    color: var(--paper);
    background: var(--manuscript-ink);
  }

  .primary-action:hover {
    border-color: var(--vermillion);
    background: var(--vermillion);
    transform: translateY(-2px);
  }

  .text-action { color: var(--manuscript-muted); }
  .text-action:hover { color: var(--vermillion); }

  .hero-foot {
    display: flex;
    justify-content: space-between;
    margin-top: -3.1rem;
    padding-bottom: 2rem;
    color: var(--manuscript-muted);
    font-family: var(--home-interface);
    font-size: 0.58rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .manuscript-section {
    position: relative;
    padding: clamp(6rem, 11vw, 10rem) 0;
    border-bottom: 1px solid var(--rule-strong);
    background: var(--paper-raised);
  }

  .realms-section::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: linear-gradient(90deg, transparent calc(50% - 0.5px), var(--rule) 50%, transparent calc(50% + 0.5px));
    opacity: 0.6;
  }

  .section-intro {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr) minmax(280px, 0.62fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: end;
    margin-bottom: 4rem;
  }

  .section-number {
    color: var(--vermillion);
    font-family: var(--font-display);
    font-size: 3.2rem;
    font-style: italic;
    line-height: 1;
    opacity: 0.8;
  }

  .section-kicker,
  .realm-label,
  .realm-index,
  .recent-number {
    color: var(--manuscript-muted);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .section-intro h2,
  .contact-layout h2 {
    margin-top: 0.8rem;
    color: var(--manuscript-ink);
    font-size: clamp(3rem, 6vw, 5.8rem);
    font-weight: 420;
    line-height: 0.92;
    letter-spacing: -0.045em;
  }

  .section-summary {
    max-width: 450px;
    color: var(--manuscript-muted);
    font-family: var(--font-display);
    font-size: 1.16rem;
    line-height: 1.65;
  }

  .realms-summary-row {
    display: flex;
    justify-content: flex-end;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  .realm-ledger {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--rule-strong);
    border-bottom: 1px solid var(--rule-strong);
  }

  .realm-entry {
    position: relative;
    min-width: 0;
    border-right: 1px solid var(--rule-strong);
    padding: 1.5rem clamp(1rem, 2vw, 1.6rem) 1.8rem;
    color: var(--manuscript-ink);
    transition: color 180ms ease;
  }

  .realm-entry:last-child { border-right: 0; }

  .realm-entry::after {
    content: "";
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    width: 1.6rem;
    height: 1px;
    background: var(--vermillion);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 180ms ease;
  }

  .realm-entry:hover::after { transform: scaleX(1); }
  .realm-index { position: relative; z-index: 1; color: var(--vermillion); }
  .realm-label { display: block; margin-top: 1rem; }

  .realm-mark { display: none; }

  .realm-entry h3 {
    position: relative;
    z-index: 1;
    max-width: 12ch;
    margin-top: 1.6rem;
    color: inherit;
    font-size: clamp(1.35rem, 2vw, 1.8rem);
    font-weight: 420;
    line-height: 1.04;
  }

  .realm-entry p {
    position: relative;
    z-index: 1;
    margin-top: 1rem;
    color: var(--manuscript-muted);
    font-size: 0.82rem;
    line-height: 1.6;
  }

  .realm-open {
