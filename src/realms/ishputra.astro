---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const reels = [
  { label: 'Reel 1', href: 'https://www.instagram.com/reel/C6ii8K0r4xF/' },
  { label: 'Reel 2', href: 'https://www.instagram.com/reel/C_PfOcTyxUH/' },
  { label: 'Reel 3', href: 'https://www.instagram.com/reel/C_QeuTRSuyO/' },
  { label: 'Reel 4', href: 'https://www.instagram.com/reel/DCoeKGINDdd/' },
];
---

<BaseLayout
  title="Ishputra | Realms Archive"
  description="A small Realms archive page collecting Ishputra Instagram reels."
  tags={["Ishputra", "Realms", "Instagram reels", "archive"]}
  bodyClass="ishputra-page"
>
  <Nav />
  <main class="ishputra-main min-h-screen px-6 py-20 md:px-20">
    <section class="ishputra-sheet mx-auto max-w-4xl p-8 md:p-12">
      <p class="ishputra-eyebrow mb-4 font-mono text-xs uppercase tracking-[0.28em]">Realms / Linked Archive</p>
      <h1 class="mb-6 font-serif text-5xl md:text-7xl tracking-tight">Ishputra</h1>
      <p class="ishputra-intro mb-12 max-w-2xl text-lg leading-relaxed">
        Collected Instagram reels preserved here as reference links.
      </p>

      <div class="grid gap-4 sm:grid-cols-2">
        {reels.map((reel) => (
          <a
            href={reel.href}
            target="_blank"
            rel="noopener noreferrer"
            class="ishputra-card group border p-6 transition hover:-translate-y-0.5"
          >
            <span class="ishputra-card-label block font-mono text-xs uppercase tracking-[0.2em]">Instagram</span>
            <span class="mt-4 block font-serif text-3xl">{reel.label}</span>
            <span class="ishputra-url mt-6 block break-all text-sm group-hover:underline">{reel.href}</span>
          </a>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  :global(body.ishputra-page) {
    --ish-bg: #17120e;
    --ish-sheet: #211a14;
    --ish-card: #292018;
    --ish-card-hover: #33271d;
    --ish-text: #f1e2c9;
    --ish-muted: #bca98d;
    --ish-accent: #c58a62;
    --ish-rule: rgb(217 187 145 / 0.24);
    background: var(--ish-bg);
    color: var(--ish-text);
  }

  :global(html[data-theme="bright"] body.ishputra-page) {
    --ish-bg: #fdfcfb;
    --ish-sheet: #ffffff;
    --ish-card: #ffffff;
    --ish-card-hover: #f7f4ef;
    --ish-text: #1a1a1a;
    --ish-muted: #5d5348;
    --ish-accent: #8b5d3c;
    --ish-rule: rgb(26 26 26 / 0.15);
  }

  .ishputra-main { color: var(--ish-text); background: var(--ish-bg); }
  .ishputra-sheet { background: transparent; }
  .ishputra-eyebrow, .ishputra-card-label { color: var(--ish-accent); }
  .ishputra-intro, .ishputra-url { color: var(--ish-muted); }
  .ishputra-card { border-color: var(--ish-rule); background: var(--ish-card); }
  .ishputra-card:hover { border-color: var(--ish-accent); background: var(--ish-card-hover); }
</style>
