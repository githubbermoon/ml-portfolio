---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import "../../styles/editorial-remix.scss";

export async function getStaticPaths() {
  const entries = await getCollection("realms", ({ data }) => data.status !== "archived" && (!import.meta.env.PROD || data.status !== "draft"));
  return entries.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props as { entry: CollectionEntry<"realms"> };
const { Content, headings } = await render(entry);
const base = import.meta.env.BASE_URL;
const sectionNames = {
  "texts-systems": "Texts & Systems",
  "origins-implementations": "Origins & Implementations",
  "field-notes": "Field Notes",
  essay: "Essays",
};
const sectionLinks = {
  "texts-systems": `${base}technical-work/`,
  "origins-implementations": `${base}projects/`,
  "field-notes": `${base}blog/essays/`,
  essay: `${base}blog/essays/`,
};
const date = entry.data.date.toLocaleDateString("en-GB", { day: "2-digit", month: "long", year: "numeric" });
const isCalendrical = entry.slug === "calendrical-systems";
const isTextComputation = entry.slug === "text-and-computation";
const cover = isCalendrical
  ? `${base}essays/a-measure-of-days/projected-calendar.jpeg`
  : isTextComputation
    ? `${base}essays/a-measure-of-days/manuscript.jpeg`
    : entry.data.cover;
const bodyClass = `archive-entry-page${isCalendrical ? " editorial-remix calendrical-remix" : ""}${isTextComputation ? " editorial-remix text-computation-remix" : ""}`;
---

<BaseLayout title={`${entry.data.title} | Kosh`} description={entry.data.summary} image={cover ?? "/ananta-nihara-hero.png"} type="article" publishedDate={entry.data.date.toISOString()} bodyClass={bodyClass}>
  <Nav />
  <main class:list={["entry-page", isCalendrical && "calendar-page"]}>
    <header class:list={["entry-header", isCalendrical && "calendar-hero", isTextComputation && "computation-hero"]}>
      <a href={sectionLinks[entry.data.category]}>{sectionNames[entry.data.category]}</a>
      <p>{entry.data.kind.replace("-", " ")} · {entry.data.status}</p>
      {isCalendrical ? <h1><span>Calendrical</span><em>Systems</em></h1> : isTextComputation ? <h1><span>Text</span><em>&amp;</em><span>Computation</span></h1> : <h1>{entry.data.title}</h1>}
      <p class="summary">{entry.data.summary}</p>
      <div class="entry-meta"><time datetime={entry.data.date.toISOString()}>{date}</time><span>Pranjal Prakash Pandey</span></div>
    </header>
    {cover && <figure class:list={["entry-cover", "editorial-curtain", isCalendrical && "calendar-cover", isTextComputation && "computation-cover"]}><img src={cover} alt={isCalendrical ? "A hand touching the center of a projected circular calendrical diagram" : isTextComputation ? "An open historical manuscript bearing handwritten text and traces of use" : ""} />{isCalendrical && <figcaption><span>Plate 01</span>The circle is useful only when its assumptions remain visible.</figcaption>}{isTextComputation && <figcaption><span>Plate 01</span> The source has a body before the model gives it a structure.</figcaption>}</figure>}
    {isCalendrical && <div class="editorial-marquee calendar-marquee" aria-hidden="true"><div><span>Cycle · observation · correspondence</span><i>§</i><span>Source before synthesis</span><i>§</i><span>Cycle · observation · correspondence</span><i>§</i><span>Source before synthesis</span><i>§</i></div></div>}
    {isCalendrical && <section class="calendar-preface"><p>Research premise · 00</p><blockquote>A calendar is never only a count of days. It is an agreement between observation, social life, ritual, memory, and the instruments available to a culture.</blockquote><figure><img src={base + "essays/a-measure-of-days/manuscript.jpeg"} alt="An open manuscript bearing handwritten records" loading="lazy" /><figcaption>Record before equivalence.</figcaption></figure></section>}
    {isTextComputation && <div class="editorial-marquee editorial-marquee--light" aria-hidden="true"><div><span>Encode · compare · return</span><i>§</i><span>The model is not the source</span><i>§</i><span>Encode · compare · return</span><i>§</i><span>The model is not the source</span><i>§</i></div></div>}
    {isTextComputation && <section class="computation-preface"><p>Study premise · 00</p><blockquote>What becomes newly visible when a text is made computable—and what disappears at exactly the same moment?</blockquote><div><span>Working position</span><p>Every transformation is an interpretation. The responsible system keeps a path back to the page.</p></div></section>}
    <div class:list={["entry-body", { "has-contents": headings.length > 2 }, isTextComputation && "computation-reading"]}>
      {headings.length > 2 && <aside><p>Contents</p>{headings.filter((heading) => heading.depth === 2).map((heading) => <a href={`#${heading.slug}`}>{heading.text}</a>)}</aside>}
      <article class="prose"><Content /></article>
    </div>
    {isCalendrical && <footer class="calendar-coda"><span>§</span><p>This notebook remains open. Definitions, diagrams, sources, and computational sketches will be added without collapsing distinct traditions into one system.</p><a href={base + "experiments/a-measure-of-days/"}>Read A Measure of Days →</a></footer>}
    {isTextComputation && <footer class="computation-coda"><span>§</span><p>A computational reading is useful when it sends us back to the text with a better question.</p><a href={base + "technical-work/"}>Return to Texts &amp; Systems →</a></footer>}
  </main>
  <Footer />
</BaseLayout>

<style>
  :global(body.archive-entry-page) { background: var(--inner-paper); color: var(--inner-ink); }
  .entry-page { width: min(100% - 3rem, 1120px); margin: auto; padding: clamp(8rem, 14vw, 12rem) 0 7rem; }
  .entry-header { max-width: 52rem; margin-left: clamp(0rem, 10vw, 10rem); }
  .entry-header > a, .entry-header > p, .entry-meta, .entry-body aside { font-family: var(--font-mono); font-size: .58rem; letter-spacing: .16em; text-transform: uppercase; }
  .entry-header > a { color: var(--inner-accent); }
  .entry-header > p { margin-top: 1rem; color: var(--inner-muted); }
  h1 { margin-top: 2rem; font-family: var(--font-display); font-size: clamp(3.5rem, 8vw, 7rem); font-weight: 400; line-height: .9; letter-spacing: -.055em; }
  .summary { margin-top: 2rem !important; color: var(--inner-muted) !important; font-family: var(--font-display) !important; font-size: clamp(1.2rem, 2vw, 1.6rem) !important; letter-spacing: 0 !important; line-height: 1.55; text-transform: none !important; }
  .entry-meta { display: flex; gap: 2rem; margin-top: 2.5rem; color: var(--inner-muted); }
  .entry-cover { width: 100%; max-height: 72vh; margin-top: 5rem; object-fit: cover; }
  .entry-body { display: grid; grid-template-columns: 12rem minmax(0, 42rem); gap: clamp(2rem, 7vw, 7rem); margin-top: 6rem; }
  .entry-body:not(.has-contents) { display: block; max-width: 42rem; margin-left: clamp(0rem, 10vw, 10rem); }
  .entry-body aside { position: sticky; top: 6rem; align-self: start; display: grid; gap: .85rem; color: var(--inner-muted); }
  .entry-body aside p { color: var(--inner-accent); }
  .prose { font-family: var(--font-display); font-size: 1.15rem; line-height: 1.85; }
  .prose :global(h2) { margin: 3.5rem 0 1.25rem; font-size: 2.25rem; font-weight: 400; line-height: 1.1; }
  .prose :global(h2:first-child) { margin-top: 0; }
  .prose :global(p + p), .prose :global(ul), .prose :global(ol), .prose :global(blockquote) { margin-top: 1.25rem; }
  .prose :global(a) { color: var(--inner-accent); text-decoration: underline; text-underline-offset: .2em; }
  .prose :global(blockquote) { padding-left: 1.5rem; border-left: 1px solid var(--inner-accent); font-size: 1.35rem; font-style: italic; }
  @media (max-width: 720px) {
    .entry-page { width: min(100% - 2rem, 1120px); padding-top: 7rem; }
    .entry-header { margin-left: 0; }
    .entry-body { grid-template-columns: 1fr; }
    .entry-body aside { position: static; }
  }
</style>
