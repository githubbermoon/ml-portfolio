---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Photos & Words | Pranjal" description="Photos, moving images, and words from Pranjal Prakash Pandey." bodyClass="personal-page">
  <Nav />
  <main class="personal-notebook">
    <header><a href={base + "#about"}>← About me</a><p>Pranjal Prakash Pandey</p><h1>Photos <em>&amp;</em> words</h1></header>
    <section class="personal-intro">
      <nav class="personal-paths" aria-label="Personal notebooks">
        <a href={base + "about/sacred-himalayan-abode/"}><span>01</span><strong>Sacred Himalayan abode</strong><i>↗</i></a>
        <a href={base + "about/metaphysical-secrets/"}><span>02</span><strong>Metaphysical secrets</strong><small>Private</small><i>↗</i></a>
      </nav>
      <figure class="moving-image"><div id="video-home"><video id="personal-video" autoplay muted loop playsinline preload="metadata" poster={base + "about/pranjal/mountains-poster.jpg"} aria-label="Pranjal in a snowy mountain landscape" tabindex="0"><source src={base + "about/pranjal/mountains.mp4"} type="video/mp4" /></video></div><div class="video-actions"><button id="pause-video" type="button">Pause</button><button id="mute-video" type="button">Unmute</button><button id="expand-video" type="button">Expand video ↗</button></div></figure>
    </section>
    <section class="photo-entry"><figure class="mountain-plate"><button class="expand-photo" type="button" aria-label="Enlarge mountain photograph"><img src={base + "about/pranjal/mountains-photo.jpeg"} alt="Pranjal standing among snow-covered mountain peaks" loading="lazy" /></button><figcaption>Enlarge ↗</figcaption></figure><div class="photo-words"><h3>At the edge of scale</h3><div class="photo-words__columns"><p>The vast expanse of the snow-laden Himalayas may become a bore to the uninterested. But to those who can sense and see, in that eerie silence, what others cannot, the Himalayas reveal their secrets.</p><p>I return to photographs like this because they resist the urge to make experience tidy. The frame records a crossing rather than a conquest: a temporary presence, a difficult surface, and the quiet awareness that the place exceeds the person moving through it.</p></div></div></section>
    <section class="photo-entry"><figure class="mountain-plate"><button class="expand-photo" type="button" aria-label="Enlarge mist photograph"><img src={base + "about/pranjal/mist-photo.jpeg"} alt="A flock grazing on a rocky hillside in thick mist" loading="lazy" /></button><figcaption>Enlarge ↗</figcaption></figure><div class="photo-words"><h3>What the weather withholds</h3><div class="photo-words__columns"><p>In the mist, distance stops behaving reliably. The flock appears first as a scattering of pale forms, while the ground loses its horizon and the hillside becomes an uncertain field of texture.</p><p>This is also a way of seeing: attention adjusts when certainty disappears. Instead of receiving the whole scene at once, the eye works slowly, finding an outline, losing it, and learning to remain with what cannot yet be made completely clear.</p></div></div></section>
    <dialog id="photo-dialog" aria-label="Expanded photograph"><button id="close-photo" type="button" autofocus>Close ×</button><img id="expanded-photo" alt="" /></dialog>
    <dialog id="video-dialog" aria-label="Expanded mountain video"><button id="close-video" type="button" autofocus>Close ×</button><div id="video-expanded"></div></dialog>
  </main>
  <Footer />
</BaseLayout>
<style>
  :global(body.personal-page) { background:#eae8e1; color:#32332e; }
  .personal-notebook { width:min(1200px,90vw); margin:0 auto; padding:8rem 0 6rem; color:#32332e; font-family:"Louize Trial",Georgia,serif; }
  header { margin-bottom:3rem; }
  header a,header>p { font:500 .7rem/1.5 "Neue Montreal Trial",Arial,sans-serif; letter-spacing:.08em; }
  header>p { margin-top:3rem; text-transform:uppercase; }
  h1 { margin:1rem 0; font:500 clamp(3.5rem,8vw,8rem)/1 "Louize Trial",Georgia,serif; letter-spacing:-.04em; }
  h1 em { font-weight:400; }
  .personal-intro { display:grid; grid-template-columns:.85fr 1.15fr; align-items:center; gap:6vw; }
  .moving-image { margin:0; min-width:0; }
  video { display:block; width:100%; height:auto; max-height:55svh; object-fit:contain; border-radius:12px; cursor:zoom-in; }
  .video-actions { display:flex; justify-content:flex-end; gap:1.2rem; }
  .moving-image button { display:block; margin:.8rem 0 0; padding:.4rem 0; background:none; border:0; color:inherit; font:500 .7rem/1.5 "Neue Montreal Trial",Arial,sans-serif; cursor:pointer; }
  h2 { font:400 italic 2rem/1.2 "Louize Trial",Georgia,serif; }
  .personal-paths { display:grid; align-self:stretch; align-content:center; border-top:1px solid rgba(50,51,46,.35); }
  .personal-paths a { display:grid; grid-template-columns:2rem 1fr auto; gap:.8rem; align-items:center; padding:1.4rem 0; border-bottom:1px solid rgba(50,51,46,.35); color:inherit; text-decoration:none; }
  .personal-paths span,.personal-paths small { font:500 .62rem/1.4 "Neue Montreal Trial",Arial,sans-serif; letter-spacing:.1em; text-transform:uppercase; }
  .personal-paths strong { font:400 clamp(1.35rem,2.4vw,2.2rem)/1.05 "Louize Trial",Georgia,serif; }
  .personal-paths small { grid-column:2; color:#7d756c; }
  .personal-paths i { grid-column:3; grid-row:1 / span 2; font-style:normal; transition:transform .2s ease; }
  .personal-paths a:hover i,.personal-paths a:focus-visible i { transform:translate(3px,-3px); }
  .mountain-plate { width:90%; margin:6rem auto 2rem; perspective:1400px; }
  .expand-photo { display:block; width:100%; border:0; padding:0; background:transparent; cursor:zoom-in; }
  .mountain-plate figcaption { margin-top:1rem; text-align:right; font:500 .7rem/1.5 "Neue Montreal Trial",Arial,sans-serif; }
  .photo-words { width:min(900px,90%); margin:3.5rem auto 0; color:#32332e; }
  .photo-words h3 { margin:0 0 4rem; text-align:center; font:400 italic 2rem/1.2 "Louize Trial",Georgia,serif; }
  .photo-words__columns { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1rem; }
  .photo-words__columns p { margin:0; font:400 1rem/1.5 "Louize Trial",Georgia,serif; text-align:justify; hyphens:auto; }
  #expanded-photo { display:block; width:100%; height:calc(100svh - 6rem); object-fit:contain; }
  #close-photo { position:absolute; right:2vw; top:1rem; padding:.6rem 1rem; border:1px solid currentColor; background:transparent; color:inherit; cursor:pointer; }
  .mountain-plate img { display:block; width:100%; height:auto; border-radius:18px; transform:rotateX(3deg) rotateY(-2deg); box-shadow:0 28px 50px -22px rgba(41,36,31,.32),0 5px 12px rgba(41,36,31,.08); }
  dialog { width:100vw; max-width:none; height:100svh; max-height:none; margin:0; padding:4rem 2vw 2rem; border:0; background:var(--manuscript-paper,#f5f3ef); color:inherit; }
  dialog::backdrop { background:rgba(30,25,20,.45); }
  dialog video { width:100%; height:calc(100svh - 6rem); max-height:none; border-radius:0; cursor:auto; }
  #close-video { position:absolute; right:2vw; top:1rem; padding:.6rem 1rem; border:1px solid currentColor; background:transparent; color:inherit; cursor:pointer; }
  @media(max-width:899px) { .personal-copy p,.photo-words__columns p { text-align:left; } }
  @media(max-width:700px) { .personal-notebook { padding-top:6rem; } .personal-intro,.photo-words__columns { grid-template-columns:1fr; gap:2rem; } .mountain-plate { width:100%; margin-top:3rem; } .photo-words h3 { margin-bottom:2rem; } }
</style>
<script>
  const video = document.querySelector<HTMLVideoElement>('#personal-video');
  const dialog = document.querySelector<HTMLDialogElement>('#video-dialog');
  const home = document.querySelector('#video-home');
  const expanded = document.querySelector('#video-expanded');
  const expandButton = document.querySelector<HTMLButtonElement>('#expand-video');
  function expandVideo() {
    if (!video || !dialog || !expanded || dialog.open) return;
    expanded.append(video);
    video.controls = true;
    dialog.showModal();
    document.body.style.overflow = 'hidden';
  }
  expandButton?.addEventListener('click', expandVideo);
  const pauseButton = document.querySelector<HTMLButtonElement>('#pause-video');
  const muteButton = document.querySelector<HTMLButtonElement>('#mute-video');
  pauseButton?.addEventListener('click', () => { if (video) { if (video.paused) video.play(); else video.pause(); } });
  muteButton?.addEventListener('click', () => { if (video) video.muted = !video.muted; });
  function syncControls() { if (video && pauseButton && muteButton) { pauseButton.textContent = video.paused ? 'Play' : 'Pause'; muteButton.textContent = video.muted ? 'Unmute' : 'Mute'; } }
  video?.addEventListener('play', syncControls);
  video?.addEventListener('pause', syncControls);
  video?.addEventListener('volumechange', syncControls);
  syncControls();
  const photoDialog = document.querySelector<HTMLDialogElement>('#photo-dialog');
  const expandedPhoto = document.querySelector<HTMLImageElement>('#expanded-photo');
  let photoTrigger: HTMLButtonElement | null = null;
  document.querySelectorAll<HTMLButtonElement>('.expand-photo').forEach((button) => button.addEventListener('click', () => {
    const image = button.querySelector('img');
    if (!image || !photoDialog || !expandedPhoto) return;
    photoTrigger = button; expandedPhoto.src = image.src; expandedPhoto.alt = image.alt;
    photoDialog.showModal(); document.body.style.overflow = 'hidden';
  }));
  document.querySelector('#close-photo')?.addEventListener('click', () => photoDialog?.close());
  photoDialog?.addEventListener('close', () => { document.body.style.overflow = ''; photoTrigger?.focus(); });

  video?.addEventListener('keydown', (event) => { if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); expandVideo(); } });
  document.querySelector('#close-video')?.addEventListener('click', () => dialog?.close());
  dialog?.addEventListener('close', () => {
    if (video && home) { home.append(video); video.controls = false; }
    document.body.style.overflow = '';
    expandButton?.focus();
  });
</script>
