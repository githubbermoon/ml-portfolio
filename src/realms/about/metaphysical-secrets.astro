---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Metaphysical Secrets | Pranjal" description="A private metaphysical notebook." bodyClass="secrets-page">
  <Nav />
  <main class="secrets-shell">
    <a class="secrets-back" href={base + "about/pranjal/"}>← Photos &amp; words</a>

    <section class="secrets-gate" data-secrets-gate>
      <p class="gate-number">02 · Private notebook</p>
      <h1>Metaphysical<br /><em>secrets</em></h1>
      <blockquote>
        I wear no robes of gold or silk, no crown upon my head,<br />
        I track the wild boar through the snows where mortal men feel dread.<br />
        I am the rugged mountain man, a simple hunter born,<br />
        Who challenged the greatest archer’s pride and left his spirit torn.<br />
        Yet look beneath my rustic mask, beyond the bow I wield<br />
        For I am the Lord of the Cosmic Dance, on the peak revealed.
      </blockquote>
      <form data-secrets-form autocomplete="off">
        <label for="secrets-answer">Who am I?</label>
        <div><input id="secrets-answer" name="answer" type="password" spellcheck="false" required /><button type="submit">Enter</button></div>
        <p class="gate-error" data-gate-error aria-live="polite"></p>
        <p class="gate-hint" data-gate-hint hidden><span>Hint</span> Name the mountain hunter form, not the archer he challenged.</p>
      </form>
      <noscript>JavaScript is required to answer the riddle.</noscript>
    </section>

    <article class="secrets-content" data-secrets-content hidden>
      <p>02 · Private notebook</p>
      <h1>Metaphysical<br /><em>secrets</em></h1>
      <div class="secrets-rule" aria-hidden="true">✦</div>
      <p>This chamber is open. Notes for this private notebook can now be added here.</p>
    </article>
  </main>
  <Footer />
</BaseLayout>

<style>
  :global(body.secrets-page) { background:#14110e; color:#eadfcf; }
  [hidden] { display:none!important; }
  .secrets-shell { width:min(1050px,calc(100% - 2rem)); min-height:92svh; margin:auto; padding:8rem 0 6rem; font-family:"Louize Trial",Georgia,serif; }
  .secrets-back,.gate-number,.secrets-content>p { font:500 .66rem/1.5 "Neue Montreal Trial",Arial,sans-serif; letter-spacing:.13em; text-transform:uppercase; }
  .secrets-back { color:#bba98f; text-decoration:none; }
  .secrets-gate,.secrets-content { width:min(49rem,100%); margin:clamp(4rem,9vh,7rem) auto 0; }
  h1 { margin:1rem 0 2.5rem; font:500 clamp(3.7rem,9vw,8rem)/.82 "Louize Trial",Georgia,serif; letter-spacing:-.055em; }
  h1 em { color:#bd674c; font-weight:400; }
  blockquote { margin:0; border-left:1px solid #7e6c58; padding-left:clamp(1rem,3vw,2.3rem); color:#d6c8b4; font-size:clamp(1rem,1.7vw,1.3rem); line-height:1.8; }
  form { margin-top:3rem; }
  label,.gate-error,.gate-hint { font:500 .7rem/1.55 "Neue Montreal Trial",Arial,sans-serif; letter-spacing:.06em; }
  form>div { display:grid; grid-template-columns:1fr auto; margin-top:.7rem; border-bottom:1px solid #81715e; }
  input { min-width:0; border:0; padding:.9rem 0; outline:0; background:transparent; color:#eadfcf; font:400 1.2rem "Louize Trial",Georgia,serif; }
  button { border:0; padding:.9rem 0 .9rem 1.5rem; background:transparent; color:#bd674c; font:600 .68rem "Neue Montreal Trial",Arial,sans-serif; letter-spacing:.12em; text-transform:uppercase; cursor:pointer; }
  .gate-error { min-height:1.2rem; margin-top:.8rem; color:#cf8068; }
  .gate-hint { margin-top:1.2rem; color:#bba98f; }
  .gate-hint span { margin-right:.7rem; color:#bd674c; text-transform:uppercase; }
  .secrets-content { text-align:center; }
  .secrets-content>p:last-child { max-width:34rem; margin:2rem auto 0; font:400 1.25rem/1.6 "Louize Trial",Georgia,serif; text-transform:none; letter-spacing:0; }
  .secrets-rule { display:flex; align-items:center; gap:1rem; color:#bd674c; }
  .secrets-rule::before,.secrets-rule::after { content:""; height:1px; flex:1; background:#5d5043; }
  @media(max-width:620px) { blockquote br { content:" "; } blockquote br::after { content:" "; } }
</style>

<script>
  const gate = document.querySelector<HTMLElement>("[data-secrets-gate]");
  const content = document.querySelector<HTMLElement>("[data-secrets-content]");
  const form = document.querySelector<HTMLFormElement>("[data-secrets-form]");
  const answer = document.querySelector<HTMLInputElement>("#secrets-answer");
  const error = document.querySelector<HTMLElement>("[data-gate-error]");
  const hint = document.querySelector<HTMLElement>("[data-gate-hint]");
  const SESSION_KEY = "metaphysical-secrets-unlocked";
  const ANSWER_HASH = "aff8acff11671fe1a4f9be4344b33462784655ffbc86ca95f78b78809e9ced3c";
  let failedAttempts = 0;

  const reveal = () => {
    if (gate) gate.hidden = true;
    if (content) content.hidden = false;
  };

  const digest = async (value: string) => {
    const bytes = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(value));
    return Array.from(new Uint8Array(bytes), (byte) => byte.toString(16).padStart(2, "0")).join("");
  };

  if (sessionStorage.getItem(SESSION_KEY) === "yes") reveal();

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const value = answer?.value.trim().toLowerCase() || "";
    if (await digest(value) === ANSWER_HASH) {
      sessionStorage.setItem(SESSION_KEY, "yes");
      if (error) error.textContent = "";
      reveal();
      return;
    }
    failedAttempts += 1;
    if (error) error.textContent = failedAttempts < 3 ? "The mountain remains closed." : "The answer is still hidden in the hunter’s form.";
    if (failedAttempts >= 3 && hint) hint.hidden = false;
    if (answer) { answer.value = ""; answer.focus(); }
  });
</script>
