---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import "../styles/editorial-remix.scss";

const base = import.meta.env.BASE_URL;
const isRealmsMode = import.meta.env.SITE_MODE === "realms";
if (!isRealmsMode) return Astro.redirect("/ml-portfolio/");
const entries = (await getCollection("realms"))
  .filter((entry) => entry.data.category === "texts-systems" && entry.data.status !== "archived" && (!import.meta.env.PROD || entry.data.status !== "draft"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const formatDate = (date: Date) => date.toLocaleDateString("en-GB", { year: "numeric", month: "short" });
---

<BaseLayout title="Texts & Systems | Kosh" description="Structured studies of texts, symbolic frameworks, calendrical systems, and computational interpretations." bodyClass="editorial-remix texts-systems-remix">
  <Nav />
  <main class="texts-page">
    <header class="texts-hero">
      <div class="texts-hero__meta"><span>Kosh research archive</span><span>Texts · Systems · Computation</span></div>
      <p class="texts-hero__part">folio one.</p>
      <h1><span>Texts</span><em>&amp;</em><span>Systems</span></h1>
      <figure class="texts-hero__image editorial-curtain" data-cursor="VIEW">
        <img src={base + "essays/a-measure-of-days/manuscript.jpeg"} alt="An open historical manuscript bearing handwritten records" />
        <figcaption><span>Plate 01</span> Before a text becomes data, it remains an encounter.</figcaption>
      </figure>
      <p class="texts-hero__intro">A research room for reading old structures with new instruments—while keeping the grain, ambiguity, and original life of the source visible.</p>
    </header>

    <div class="editorial-marquee editorial-marquee--light" aria-hidden="true"><div><span>Source before synthesis</span><i>§</i><span>Models are provisional</span><i>§</i><span>Context is part of the record</span><i>§</i><span>Source before synthesis</span><i>§</i><span>Models are provisional</span><i>§</i><span>Context is part of the record</span><i>§</i></div></div>

    <section class="texts-preface" aria-label="Research premise">
      <p>Research premise · 00</p>
      <div><p>Texts are not inert containers. Their sequence, material, marginalia, omissions, and histories participate in what they mean.</p></div>
      <div><p>Computation can reveal patterns across a corpus, but the model is a lens—not a replacement for looking.</p></div>
    </section>

    <section class="texts-register" aria-labelledby="register-title">
      <header>
        <p>Working studies · {String(entries.length).padStart(2, "0")}</p>
        <h2 id="register-title">The active<br /><em>register</em></h2>
      </header>
      <div class="texts-register__list">
        {entries.map((entry, index) => (
          <a class="texts-study editorial-reveal" href={`${base}archive/${entry.slug}/`} data-cursor="READ">
            <span class="texts-study__number">{String(index + 1).padStart(2, "0")}</span>
            <div><p>{entry.data.kind.replace("-", " ")} · {entry.data.status}</p><h3>{entry.data.title}</h3></div>
            <p class="texts-study__summary">{entry.data.summary}</p>
            <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
          </a>
        ))}
      </div>
    </section>

    <section class="texts-method">
      <figure><img src={base + "essays/a-measure-of-days/projected-calendar.jpeg"} alt="A hand meeting the center of a projected circular diagram" loading="lazy" /><figcaption>Plate 02 · Representation as an instrument of attention.</figcaption></figure>
      <div><p>Method · open notebook</p><blockquote>The useful model does not conceal its seams. It shows what entered, what changed, and what could not be carried through.</blockquote><a href={base + "archive/text-and-computation/"}>Enter Text and Computation →</a></div>
    </section>
  </main>
  <Footer />
</BaseLayout>
