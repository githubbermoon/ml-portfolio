---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import "../../styles/editorial-remix.scss";

const base = import.meta.env.BASE_URL;
const entries = (await getCollection("realms"))
  .filter((entry) => !["calendrical-systems", "calendrical-mapper"].includes(entry.slug))
  .filter((entry) => entry.data.category === "origins-implementations" && entry.data.status !== "archived" && (!import.meta.env.PROD || entry.data.status !== "draft"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const methods = [
  ["01", "Question", "Begin with a claim small enough to be tested."],
  ["02", "Trace", "Keep source, transformation, and output visibly separate."],
  ["03", "Revise", "Let observation alter the instrument that produced it."],
];
---

<BaseLayout title="Origins & Implementations | Kosh" description="Functional builds, empirical tools, and working instruments." bodyClass="editorial-remix projects-remix">
  <Nav />
  <main class="projects-page">
    <header class="projects-hero">
      <div class="projects-hero__meta"><span>Workshop · OI</span><span>Bengaluru · 2026</span></div>
      <h1><span>Origins</span><em>&amp;</em><span>Implementations</span></h1>
      <div class="projects-hero__foot"><p>Functional builds and empirical tools. Each dossier preserves the question, method, state, and revisions around the thing being made.</p><a href="#dossiers">Open the workshop ↓</a></div>
    </header>

    <section class="projects-image-band">
      <figure><img src={base + "images/projects/dew-spiderweb.jpeg"} alt="Dewdrops suspended along the threads of a spiderweb" loading="eager" /></figure>
      <div><p>The workshop does not begin with an answer.</p><span>It begins with something that can be observed.</span></div>
      <figure><img src={base + "images/projects/garden-motion.gif"} alt="Black-and-white animation of a rabbit moving through a garden" loading="lazy" /></figure>
    </section>

    <section class="projects-method">
      <header><p>Operating method · 00</p><h2>Build <em>as a way</em><br />of asking.</h2></header>
      <div>
        {methods.map(([number,title,note], index) => <><article><span>{number}</span><h3>{title}</h3><p>{note}</p></article>{index < methods.length - 1 && <i class="method-arrow" aria-hidden="true">➳</i>}</>)}
      </div>
    </section>

    <section class="projects-dossiers" id="dossiers" aria-label="Implementation dossiers">
      <header><i></i><h2>Dossiers</h2><p>{String(entries.length).padStart(2,"0")} active</p></header>
      <div class="projects-dossiers__list">
        {entries.map((entry, index) => (
          <a class="project-dossier" href={base + "archive/" + entry.slug + "/"} data-cursor="OPEN">
            <span class="project-dossier__number">{String(index + 1).padStart(2, "0")}</span>
            <div class="project-dossier__title"><p>{entry.data.kind.replace("-", " ")} · {entry.data.status}</p><h3>{entry.data.title}</h3></div>
            <p class="project-dossier__summary">{entry.data.summary}</p>
            <strong>Open dossier →</strong>
          </a>
        ))}
      </div>
    </section>

    <footer class="projects-coda">
      <p>Not every experiment becomes a product.</p>
      <h2>Some are useful because they make the next question possible.</h2>
      <a href={base + "technical-work/"}>Enter Texts &amp; Systems →</a>
    </footer>
  </main>
  <Footer />
</BaseLayout>
