---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const base = import.meta.env.BASE_URL;
const realms = [
	{
		name: "Texts & Systems",
		label: "Technical Work",
		href: "technical-work/",
		description: "Structured notes and experiments around ancient sciences, symbolic systems, and computation.",
		symbol: "01",
		date: "2026 · Systems",
		preview: base + "images/atmosphere/ritual-water.webp",
	},
	{
		name: "Ananta N",
		label: "Spiritual / speculative",
		href: "blog/ananta-n/",
		description: "Perception, intelligence, inner experience, mythic language, and visual essays.",
		symbol: "∞",
		date: "2026 · Ongoing",
		preview: base + "images/atmosphere/storm-light.webp",
	},
	{
		name: "Calendrics & Celestial Symbolism",
		label: "Celestial studies",
		href: "blog/astrology/",
		description: "Planetary notes, symbolic systems, timing, archetypes, and chart reflections.",
		symbol: "☉",
		date: "2026 · Observations",
		preview: base + "images/atmosphere/cosmic-horizon.webp",
		transitionClass: "astrology-transition",
	},
	{
		name: "Palate",
		label: "Cooking",
		href: "blog/cooking/",
		description: "Recipes, kitchen systems, taste experiments, food memory, and process notes.",
		symbol: "♨",
		date: "2026 · Kitchen",
		preview: base + "images/palate/street-food.webp",
		transitionClass: "palate-transition",
	},
	{
		name: "Field Notes",
		label: "Essays",
		href: "blog/essays/",
		description: "Personal essays, observations, reading notes, and unfinished thoughts worth preserving.",
		symbol: "✦",
		date: "2026 · Essays",
		preview: base + "images/atmosphere/storm-light.webp",
	},
	{
		name: "Index",
		label: "Reference",
		href: "blog/notes/",
		description: "Short notes, glossary entries, links, fragments, and reusable knowledge blocks.",
		symbol: "⌁",
		date: "2026 · Index",
		preview: base + "images/atmosphere/reading-notes-cover.webp",
	},
];
---

<BaseLayout
	title="Kosh (कोश) | Realms Archive"
	description="Kosh means a treasury or library. This Realms archive holds notes, references, essays, fragments, and future work on Vedic sciences and symbolic systems."
	tags={["Kosh", "Realms", "Vedic sciences", "symbolic systems", "archive"]}
	bodyClass="kosh-index-page"
>
	<Nav />
	<main class="kosh-index-main mx-auto max-w-6xl px-8 md:px-20 py-20">
		<header class="mb-24 flex flex-col md:flex-row gap-12 border-b border-gray-200 pb-20">
			<div class="flex-1">
				<p class="archive-kicker">THE LIVING ARCHIVE</p>
				<h1 class="text-6xl font-serif tracking-tight mb-8"><span class="archive-flower" aria-hidden="true">a</span> कोश <span class="archive-flower archive-flower--mirror" aria-hidden="true">a</span></h1>
				<p class="text-lg text-gray-600 leading-relaxed max-w-md">
					A treasury of notes, references, essays, fragments, and field notes.
				</p>
			</div>
		</header>

		<section class="grid md:grid-cols-2 gap-24 mb-24">
            <div class="space-y-12">
                {realms.slice(0, 3).map((realm) => (
                    <a class:list={["group cursor-pointer block editorial-reveal realm-preview-link", realm.transitionClass]} href={base + realm.href} data-preview-card data-cursor="OPEN">
                        <h2 class="text-2xl font-bold mb-2 group-hover:underline">{realm.name}</h2>
                        <p class="text-gray-600 text-sm leading-6">{realm.description}</p>
                        <span class="realm-date">{realm.date}</span>
                        <img class="realm-floating-preview" src={realm.preview} alt="" aria-hidden="true" loading="lazy" />
                    </a>
                ))}
            </div>

            <div class="border-l border-gray-200 pl-12 space-y-12">
                {realms.slice(3).map((realm) => (
                    <a class:list={["group cursor-pointer block editorial-reveal realm-preview-link", realm.transitionClass]} href={base + realm.href} data-preview-card data-cursor="OPEN">
                        <h2 class="text-2xl font-bold mb-2 group-hover:underline">{realm.name}</h2>
                        <p class="text-gray-600 text-sm leading-6">{realm.description}</p>
                        <span class="realm-date">{realm.date}</span>
                        <img class="realm-floating-preview" src={realm.preview} alt="" aria-hidden="true" loading="lazy" />
                    </a>
                ))}
            </div>
		</section>

	</main>
	<Footer />
</BaseLayout>

<style>
	:global(body.kosh-index-page) {
		--kosh-page: #17120e;
		--kosh-text: #f1e2c9;
		--kosh-muted: #bca98d;
		--kosh-rule: rgb(217 187 145 / 0.24);
		background: var(--kosh-page);
		color: var(--kosh-text);
	}

	:global(html[data-theme="bright"] body.kosh-index-page) {
		--kosh-page: #fdfcfb;
		--kosh-text: #1a1a1a;
		--kosh-muted: #655c52;
		--kosh-rule: rgb(26 26 26 / 0.14);
	}

	.kosh-index-main {
		color: var(--kosh-text);
		background: var(--kosh-page);
	}

	.kosh-index-main :global(.text-gray-600),
	.kosh-index-main :global(.text-gray-500),
	.kosh-index-main :global(.text-gray-400) {
		color: var(--kosh-muted);
	}

	.kosh-index-main :global(.border-gray-200) {
		border-color: var(--kosh-rule);
	}

	.astrology-transition h2 { view-transition-name: astrology-title; }
	.palate-transition h2 { view-transition-name: palate-title; }

	.realm-preview-link { position: relative; }
	.realm-date {
		display: inline-block;
		max-height: 0;
		margin-top: 0;
		overflow: hidden;
		color: var(--kosh-muted);
		font-family: var(--font-mono);
		font-size: .55rem;
		letter-spacing: .16em;
		text-transform: uppercase;
		opacity: 0;
		transition: max-height 240ms ease, margin 240ms ease, opacity 240ms ease;
	}
	.realm-preview-link:hover .realm-date,
	.realm-preview-link:focus-visible .realm-date { max-height: 1.5rem; margin-top: .8rem; opacity: 1; }
	.realm-floating-preview {
		position: fixed;
		top: clamp(2rem, var(--preview-y, 35vh), calc(100vh - 14rem));
		left: clamp(2rem, var(--preview-x, 65vw), calc(100vw - 17rem));
		z-index: 120;
		width: min(15rem, 28vw);
		aspect-ratio: 4 / 3;
		object-fit: cover;
		opacity: 0;
		pointer-events: none;
		transform: translateY(8px) rotate(-1.2deg) scale(.97);
		transition: opacity 180ms ease, transform 320ms cubic-bezier(.22,1,.36,1);
		box-shadow: 0 18px 55px rgb(20 12 8 / .2);
	}
	.realm-preview-link:nth-child(even) .realm-floating-preview { transform: translateY(8px) rotate(1.2deg) scale(.97); }
	.realm-preview-link:hover .realm-floating-preview,
	.realm-preview-link:focus-visible .realm-floating-preview { opacity: 1; transform: translateY(0) rotate(0) scale(1); }
	@media (pointer: coarse) { .realm-floating-preview { display: none; } }
</style>

<style>
  :global(body.kosh-index-page) { --kosh-page: #f4f3f1; --kosh-text: #27231f; --kosh-muted: #716456; --kosh-rule: #27231f33; background: var(--kosh-page); font-family: "Neue Montreal Trial",Arial,sans-serif; }
  :global(html[data-theme="bright"] body.kosh-index-page) { --kosh-page: #f4f3f1; --kosh-text: #27231f; --kosh-muted: #716456; }
  .kosh-index-main { max-width: none; padding: 8rem 5vw 6rem; }
  .kosh-index-main > header { display: block; text-align: center; margin-bottom: 3rem; padding-bottom: 3rem; border: 0; }
  .archive-kicker { color: #a33e27; font: 600 .75rem/1.4 "Neue Montreal Trial",Arial,sans-serif; letter-spacing: .14em; margin-bottom: 2rem; }
  .kosh-index-main h1 { display: flex; justify-content: center; align-items: center; gap: 2rem; color: var(--kosh-text); font: 500 clamp(5rem,10vw,10rem)/1.15 "Louize Trial",Georgia,serif; letter-spacing: -.035em; margin-bottom: 1.5rem; }
  .archive-flower { display: inline-block; font: 400 .4em/1 "Dingleberries"; }
  .archive-flower--mirror { transform: scaleX(-1); }
  .kosh-index-main header .text-lg { max-width: 36ch; margin: auto; font: 400 clamp(1.4rem,2vw,2rem)/1.45 "Louize Trial",Georgia,serif; }
  .kosh-index-main > section { display: block; margin-bottom: 0; }
  .kosh-index-main > section > div { padding: 0; border: 0; }
  .kosh-index-main .realm-preview-link { display: grid; grid-template-columns: minmax(0,1.65fr) minmax(0,1fr) 2rem; align-items: center; gap: 3vw; padding: 2.5rem 0; margin: 0; text-decoration: none; }
  .realm-preview-link::after { content: "↗"; font-size: 1.5rem; color: #a33e27; }
  .kosh-index-main .realm-preview-link h2 { font: 500 clamp(2.8rem,5vw,5.8rem)/1.05 "Louize Trial",Georgia,serif; letter-spacing: -.035em; margin: 0; color: var(--kosh-text); transition: color .2s; }
  .kosh-index-main .realm-preview-link:hover h2 { color: #a33e27; text-decoration: none; }
  .kosh-index-main .realm-preview-link p { font-size: .95rem; line-height: 1.65; max-width: 38ch; }
  .realm-date, .realm-floating-preview { display: none; }
  .realm-preview-link:focus-visible { outline: 2px solid #a33e27; outline-offset: 6px; }
  @media(max-width:720px) {
    .kosh-index-main { padding: 7rem 6vw 4rem; }
    .kosh-index-main h1 { gap: 1rem; }
    .kosh-index-main .realm-preview-link { grid-template-columns: minmax(0,1fr) 1.5rem; gap: 1rem; padding: 2rem 0; }
    .kosh-index-main .realm-preview-link h2 { font-size: clamp(2.5rem,9vw,4rem); }
    .kosh-index-main .realm-preview-link p { grid-column: 1; grid-row: 2; }
    .realm-preview-link::after { grid-column: 2; grid-row: 1; }
  }
</style>
