---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import "../../styles/editorial-remix.scss";

const base = import.meta.env.BASE_URL;
const isRealmsMode = import.meta.env.SITE_MODE === "realms";
if (!isRealmsMode) return Astro.redirect("/ml-portfolio/blog/");
const essays = [
  { number: "०१", eyebrow: "हिन्दी निबन्ध · मन", title: "जल के नीचे दौड़ते घोड़े", summary: "मन, स्मृति, प्रेम और भीतर के उन अश्वों पर जो मौन में भी अपनी गति नहीं खोते।", href: "essays/jal-ke-neeche-ghode/", image: "essays/jal-ke-neeche-ghode/horse-underwater.webp" },
  { number: "02", eyebrow: "Immersive essay · Time", title: "A Measure of Days", summary: "On the instruments, stories, and agreements through which a day becomes legible.", href: "essays/a-measure-of-days/", image: "essays/a-measure-of-days/hero-garden.jpeg" },
  { number: "03", eyebrow: "Reading notes · Philosophy", title: "Fear", summary: "Notes on fear as signal, story, inheritance, and the threshold before action.", href: "blog/reading-notes/fear/", image: "images/atmosphere/reading-notes-cover-hq.webp" },
];
---

<BaseLayout title="Essays | Kosh" description="Long-form essays, reading notes, and exploratory writing by Pranjal Prakash Pandey." bodyClass="editorial-remix essays-room-remix">
  <Nav />
  <main class="essays-room">
    <header class="essays-hero">
      <div class="essays-hero__meta"><span>Field notes · long forms</span><span>Kosh, MMXXVI</span></div>
      <p>room three.</p>
      <h1><span>Essays</span><em>for slower attention</em></h1>
      <figure class="editorial-curtain"><img src={base + "images/atmosphere/field-notes-seaside.jpeg"} alt="Two people dining beside broad windows overlooking a sunlit sea" /></figure>
      <div class="essays-hero__note"><p>Writing that is allowed to wander, return, contradict itself, and find its form by staying with the question.</p><a href="#reading-room">Enter the reading room ↓</a></div>
    </header>

    <section class="essays-statement">
      <p>Editorial note · 00</p>
      <blockquote>Not every thought arrives as an argument. Some begin as atmosphere, a sentence in the margin, or an image that refuses to leave.</blockquote>
      <p>These essays preserve that slower movement from impression to inquiry. References remain visible; uncertainty is permitted to remain.</p>
    </section>

    <div class="editorial-marquee" aria-hidden="true"><div><span>Essays · reading notes · fragments</span><i>§</i><span>Attention before conclusion</span><i>§</i><span>Essays · reading notes · fragments</span><i>§</i><span>Attention before conclusion</span><i>§</i></div></div>

    <section class="essays-list" id="reading-room" aria-label="Essay collection">
      <header><p>Selected writing · {String(essays.length).padStart(2, "0")}</p><h2>A small library<br /><em>of open questions</em></h2></header>
      {essays.map((essay, index) => (
        <a class:list={["essay-row", index % 2 && "essay-row--reverse"]} href={base + essay.href} data-cursor="READ">
          <div class="essay-row__copy"><span>{essay.number}</span><p>{essay.eyebrow}</p><h3>{essay.title}</h3><div>{essay.summary}</div><strong>Read essay →</strong></div>
          <figure class="editorial-curtain"><img src={base + essay.image} alt="" loading="lazy" /><figcaption>Folio {essay.number}</figcaption></figure>
        </a>
      ))}
    </section>

    <footer class="essays-coda"><span>§</span><p>Read slowly. Keep what glows. Return when the ground has shifted.</p><a href={base + "blog/notes/"}>Continue to Notes →</a></footer>
  </main>
  <Footer />
</BaseLayout>
