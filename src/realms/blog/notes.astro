---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import "../../styles/editorial-remix.scss";

const base = import.meta.env.BASE_URL;
const isRealmsMode = import.meta.env.SITE_MODE === "realms";
if (!isRealmsMode) return Astro.redirect("/ml-portfolio/blog/");

const shelves = [
  { number: "01", kind: "Reading note", tags: "fear · cinema · attention", title: "On living without fear", summary: "Two textual passages on duality, self-restraint, and the conditions of fearlessness.", href: base + "blog/reading-notes/fear/" },
  { number: "02", kind: "Research notebook", tags: "calendrics · observation", title: "Calendrical Systems", summary: "A comparative vocabulary for cycles, observation, and symbolic time.", href: base + "archive/calendrical-systems/" },
  { number: "03", kind: "Instrument", tags: "mapping · traceability", title: "Calendrical Mapper", summary: "An interface for comparing cycles without presenting distinct traditions as equivalent.", href: base + "archive/calendrical-mapper/" },
  { number: "04", kind: "Inner-world archive", tags: "myth · perception", title: "Ananta N", summary: "Fragments concerning perception, mythic language, and private cosmology.", href: base + "blog/ananta-n/" },
  { number: "05", kind: "Process note", tags: "food · method · memory", title: "Pizza, recorded as practice", summary: "A recipe read as repetition, material knowledge, and remembered gesture.", href: base + "blog/cooking/pizza/" },
  { number: "06", kind: "Celestial index", tags: "symbol · sky · time", title: "Calendrics & Celestial Symbolism", summary: "A nocturnal room for charts, transits, and disciplined symbolic observation.", href: base + "blog/astrology/" },
];
---

<BaseLayout title="Field Notes & Index | Kosh" description="Short notes, references, links, and reusable knowledge blocks from the Kosh archive." bodyClass="editorial-remix notes-remix">
  <Nav />
  <main class="notes-page">

    <div class="notes-manuscript">
      <p><span>Working principle</span>Preserve the source. Separate observation from interpretation. Leave the revision visible.</p>
    </div>

    <section class="notes-shelves" id="shelves">
      <header>
        <i></i>
        <h2>Index</h2>
        <p>Garden · active notes</p>
      </header>
      <div class="notes-grid">
        {shelves.map((item) => (
          <article class="notes-card">
            <a href={item.href}>
              <div class="notes-card__meta"><span>{item.number}</span><p>{item.kind}<small>{item.tags}</small></p></div>
              <h3>{item.title}</h3>
              <p class="notes-card__summary">{item.summary}</p>
              <strong>Open note →</strong>
            </a>
          </article>
        ))}
      </div>
    </section>


    <div class="editorial-marquee editorial-marquee--light" aria-hidden="true">
      <div>{Array.from({length: 12}, () => <><span>Nothing here is final</span><i>✦</i><span>Everything here is traceable</span><i>✦</i></>)}</div>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .notes-page > .editorial-marquee { width: 100%; max-width: none; margin-inline: 0; }
  .notes-page > .editorial-marquee > div { margin: 0; justify-content: flex-start; }
</style>
