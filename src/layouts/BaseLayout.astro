---
import "../styles/global.css";
import "../styles/realms-inner.css";
import Spotlight from "../islands/Spotlight";
import ThemeToggle from "../islands/ThemeToggle";
import AnalyticsHotkey from "../islands/AnalyticsHotkey";
import ExperienceLayer from "../components/ExperienceLayer.astro";
import VisitorMeasurement from "../components/VisitorMeasurement.astro";
import DispatchesSubscription from "../components/DispatchesSubscription.astro";

const {
  lang = "en",
  title = "Pranjal Prakash Pandey | ML Portfolio & Realms",
  description = "Machine learning portfolio and Realms archive by Pranjal Prakash Pandey: computer vision projects, ML systems, technical writing, and immersive field notes.",
  bodyClass,
  image = "/ananta-n-hero.png",
  type = "website",
  noindex = false,
  publishedDate,
  modifiedDate,
  tags = [],
  hideDispatchesSubscription = false,
} = Astro.props;
const base = import.meta.env.BASE_URL;
const isRealmsMode = import.meta.env.SITE_MODE === "realms";
const isRealmsInnerPage = isRealmsMode && Astro.url.pathname !== "/";
const goatCounterCode = import.meta.env.PUBLIC_GOATCOUNTER_CODE;
const siteOrigin = (Astro.site ?? new URL(isRealmsMode ? "https://realms-58q.pages.dev" : "https://githubbermoon.github.io")).toString();
const normalizedBase = base.endsWith("/") ? base : `${base}/`;
const normalizedPath = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`;
const isKoshIndex = isRealmsMode && normalizedPath === `${normalizedBase}blog/`;
const isImmersiveRealmsPage = isRealmsMode && normalizedPath.startsWith(`${normalizedBase}blog/cooking/`);
const isRealmsManuscriptInner = isRealmsInnerPage && !isKoshIndex && !isImmersiveRealmsPage;
const realmsBackHref = normalizedPath.startsWith(`${normalizedBase}blog/cooking/pizza/`)
  ? `${normalizedBase}blog/cooking/`
  : normalizedPath.startsWith(`${normalizedBase}blog/`) && normalizedPath !== `${normalizedBase}blog/`
    ? `${normalizedBase}blog/`
    : normalizedBase;
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).toString();
const imagePath = image.startsWith("http")
  ? image
  : image.startsWith(normalizedBase)
    ? image
    : image.startsWith("/")
      ? `${normalizedBase}${image.slice(1)}`
      : `${normalizedBase}${image}`;
const imageUrl = new URL(imagePath, siteOrigin).toString();
const siteName = isRealmsMode ? "Realms by Pranjal Prakash Pandey" : "Pranjal Prakash Pandey | Machine Learning Portfolio";
const rightsUrl = new URL(`${normalizedBase}rights/`, siteOrigin).toString();
const ogImageAlt = isRealmsMode
  ? "Realms: cinematic writing archive by Pranjal Prakash Pandey"
  : "Pranjal Prakash Pandey machine learning portfolio and technical writing";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": type === "article" ? "Article" : "WebSite",
  name: title,
  headline: title,
  description,
  url: canonicalUrl,
  image: imageUrl,
  author: {
    "@type": "Person",
    name: "Pranjal Prakash Pandey",
    url: siteOrigin,
    ...(!isRealmsMode && {
      sameAs: [
        "https://github.com/githubbermoon",
        "https://linkedin.com/in/pranjal-prakash",
      ],
    }),
  },
  ...(isRealmsMode && {
    copyrightHolder: {
      "@type": "Person",
      name: "Pranjal Prakash Pandey",
      alternateName: "Himavat",
    },
    copyrightYear: 2026,
    license: rightsUrl,
  }),
  ...(publishedDate ? { datePublished: publishedDate } : {}),
  ...(modifiedDate ? { dateModified: modifiedDate } : {}),
  ...(tags.length ? { keywords: tags.join(", ") } : {}),
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {tags.length > 0 && <meta name="keywords" content={tags.join(", ")} />}
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow, max-image-preview:large" />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" type="application/xml" href={base + "sitemap.xml"} />
    {isRealmsMode && <link rel="alternate" type="application/rss+xml" title="Kosh Dispatches" href={base + "dispatches.xml"} />}
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#050505" />
    <meta name="author" content="Pranjal Prakash Pandey" />
    {isRealmsMode && <meta name="copyright" content="© 2026 Himavat · Pranjal Prakash Pandey. All rights reserved." />}
    {isRealmsMode && <meta name="dcterms.rights" content={rightsUrl} />}
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    {!isRealmsMode && <meta name="twitter:creator" content="@githubbermoon" />}
    {publishedDate && <meta property="article:published_time" content={publishedDate} />}
    {modifiedDate && <meta property="article:modified_time" content={modifiedDate} />}
    {tags.map((tag: string) => <meta property="article:tag" content={tag} />)}
    <link rel="icon" type="image/png" href={base + (isRealmsMode ? "favicon-realms.png" : "favicon.svg")} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <slot name="head" />
    <script is:inline>
      const storedTheme = localStorage.getItem("clawd-theme");
      const prefersLight = window.matchMedia(
        "(prefers-color-scheme: light)",
      ).matches;
      const resolvedTheme =
        storedTheme === "bright" || storedTheme === "dark"
          ? storedTheme
          : storedTheme === "auto"
            ? prefersLight
              ? "bright"
              : "dark"
            : "bright";
      document.documentElement.dataset.theme = resolvedTheme;
      const storedFilm = localStorage.getItem("clawd-film");
      const prefersReduced = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      const prefersContrast = window.matchMedia(
        "(prefers-contrast: more)",
      ).matches;
      const filmEnabled =
        !prefersReduced &&
        !prefersContrast &&
        (storedFilm === "on"
          ? true
          : storedFilm === "off"
            ? false
            : resolvedTheme !== "bright");
      document.documentElement.dataset.film = filmEnabled ? "on" : "off";

      window.addEventListener("cut-to-project", () => {
        document.body.classList.add("warp-active");
      });

    </script>
    {!isRealmsMode && goatCounterCode && (
      <script
        data-goatcounter={`https://${goatCounterCode}.goatcounter.com/count`}
        async
        src="//gc.zgo.at/count.js"
      ></script>
    )}
    <title>{title}</title>
  </head>
  <body class:list={[bodyClass, isRealmsManuscriptInner && "realms-manuscript-inner"]}>
    {!isRealmsMode && !isRealmsInnerPage && (
      <div class="fixed top-6 right-6 z-[100] pointer-events-auto">
        <ThemeToggle client:load />
      </div>
    )}
    <Spotlight client:load />
    <ExperienceLayer />
    {isRealmsInnerPage && (
      <a class="realms-back-link" href={realmsBackHref} aria-label="Back to previous section" data-cursor="BACK">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M15 6 9 12l6 6" />
        </svg>
      </a>
    )}
    <slot />
    {isRealmsMode && !hideDispatchesSubscription && <DispatchesSubscription />}
    {isRealmsMode && <VisitorMeasurement />}
    {!isRealmsMode && <AnalyticsHotkey client:load goatCounterCode={goatCounterCode} />}
    <svg
      aria-hidden="true"
      focusable="false"
      width="0"
      height="0"
      style="position:absolute; width:0; height:0; overflow:hidden;"
    >
      <filter
        id="liquid-hero-filter"
        x="-40%"
        y="-40%"
        width="180%"
        height="180%"
        color-interpolation-filters="sRGB"
      >
        <feTurbulence
          type="fractalNoise"
          baseFrequency="0.008 0.02"
          numOctaves="2"
          seed="8"
          result="noise"></feTurbulence>
        <feDisplacementMap
          id="liquid-hero-displacement"
          in="SourceGraphic"
          in2="noise"
          scale="0"
          xChannelSelector="R"
          yChannelSelector="G"></feDisplacementMap>
      </filter>
    </svg>
    <div class="film-overlay" aria-hidden="true">
      <div class="film-grain"></div>
      <div class="film-vignette"></div>
    </div>
  </body>
</html>

<style>
  :global(.realms-back-link) {
    position: fixed;
    top: 1.3rem;
    left: max(1rem, calc((100vw - 1240px) / 2));
    z-index: 145;
    display: grid;
    width: 2.25rem;
    height: 2.25rem;
    place-items: center;
    color: #3f3127;
    opacity: 0.72;
    transition: color 160ms ease, opacity 160ms ease, transform 160ms ease;
  }
  :global(html:not([data-theme="bright"]) .realms-back-link) {
    color: #ead9be;
  }
  :global(.realms-back-link:hover) {
    color: #a1442f;
    opacity: 1;
    transform: translateX(-2px);
  }
  :global(.realms-back-link svg) {
    width: 0.9rem;
    height: 0.9rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
