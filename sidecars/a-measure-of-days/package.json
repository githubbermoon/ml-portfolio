{
  "name": "kosh-a-measure-of-days-sidecar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rm -rf ../../public/experiments/a-measure-of-days",
    "styles": "sass --no-source-map src/scss:../../public/experiments/a-measure-of-days/css --style compressed",
    "scripts": "rollup --config",
    "content": "eleventy",
    "build": "pnpm clean && pnpm styles && pnpm scripts && pnpm content",
    "start": "concurrently -k -n sass,rollup,eleventy 'sass --no-source-map --watch src/scss:../../public/experiments/a-measure-of-days/css --style compressed' 'rollup --config --watch' 'eleventy --serve --quiet'"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@11ty/eleventy-img": "^6.0.4",
    "@11ty/eleventy-plugin-webc": "^0.11.2",
    "@rollup/plugin-dynamic-import-vars": "^2.1.5",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@unseenco/taxi": "1.8.0",
    "concurrently": "^9.2.1",
    "gsap": "^3.15.0",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "rollup": "^4.50.1",
    "sass": "^1.92.1"
  }
}
